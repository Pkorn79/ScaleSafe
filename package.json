{
  "name": "scalesafe",
  "version": "1.0.0",
  "description": "ScaleSafe — Evidence-powered chargeback defense for high-ticket service businesses. GHL Marketplace app.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build-ui && npm run copy-build-assets",
    "copy-build-assets": "node scripts/copy-build-assets.js",
    "build-ui": "cd src/ui && npm install && npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:guardian-db-vectors": "node scripts/verify-guardian-db-vectors.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pkorn79/ScaleSafe.git"
  },
  "author": "ScaleSafe",
  "license": "ISC",
  "dependencies": {
    "@sparticuz/chromium": "^147.0.0",
    "@supabase/supabase-js": "^2.115.0",
    "axios": "^1.20.0",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "fast-xml-parser": "^5.11.1",
    "multer": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "puppeteer-core": "^24.40.0",
    "qs": "6.16.0",
    "sanitize-html": "2.17.7",
    "stripe": "^22.6.1",
    "vue": "^3.5.42"
  },
  "overrides": {
    "ip-address": "10.7.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.18",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.8.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qs": "^6.15.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
