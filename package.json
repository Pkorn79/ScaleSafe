{
  "name": "scalesafe",
  "version": "1.0.0",
  "description": "ScaleSafe — Evidence-powered chargeback defense for high-ticket service businesses. GHL Marketplace app.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build-ui && npm run copy-build-assets",
    "copy-build-assets": "node scripts/copy-build-assets.js",
    "build-ui": "cd src/ui && npm install && npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pkorn79/ScaleSafe.git"
  },
  "author": "ScaleSafe",
  "license": "ISC",
  "dependencies": {
    "@sparticuz/chromium": "^147.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.18.1",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "fast-xml-parser": "^5.8.0",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "puppeteer-core": "^24.40.0",
    "qs": "^6.15.2",
    "sanitize-html": "2.13.1",
    "stripe": "^22.0.0",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.18",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.8.2",
    "@types/pdfkit": "^0.17.5",
    "@types/qs": "^6.9.9",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
