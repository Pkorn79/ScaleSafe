{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalesafe.app/protocol/guardian/v1/error-response.schema.json",
  "title": "ScaleSafe Guardian Error Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "error_code",
    "request_id",
    "server_time"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "error_code": {
      "enum": [
        "NOT_FOUND",
        "AUTHENTICATION_FAILED",
        "PAYLOAD_TOO_LARGE",
        "UNSUPPORTED_MEDIA_TYPE",
        "VALIDATION_FAILED",
        "RATE_LIMITED",
        "SEQUENCE_CONFLICT",
        "LOGICAL_ID_CONFLICT",
        "INTERNAL_ERROR"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/uuid"
    },
    "server_time": {
      "$ref": "#/$defs/utcTimestamp"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
