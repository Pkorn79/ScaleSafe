{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalesafe.app/protocol/guardian/v1/snapshot.schema.json",
  "title": "ScaleSafe Guardian Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_sequence",
    "generated_at",
    "expires_at",
    "build_sha",
    "application_version",
    "schema_version",
    "checks",
    "open_incidents"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_sequence": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
    },
    "generated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "build_sha": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "^[A-Fa-f0-9]{7,64}$"
    },
    "application_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]{0,63}$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "open_incidents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "info",
        "warning",
        "urgent",
        "critical"
      ],
      "properties": {
        "info": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "warning": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "urgent": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "critical": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        }
      }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "nonnegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "metricValue": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,63}$"
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_key",
        "state",
        "severity",
        "observed_at",
        "failure_code",
        "metrics"
      ],
      "properties": {
        "check_key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "unhealthy",
            "unknown"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "urgent",
            "critical"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "metrics": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/metricValue"
          }
        }
      }
    }
  }
}
