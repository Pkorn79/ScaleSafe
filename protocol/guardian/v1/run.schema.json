{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalesafe.app/protocol/guardian/v1/run.schema.json",
  "title": "ScaleSafe Guardian Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "instance_id",
    "run_id",
    "agent_version",
    "started_at",
    "completed_at",
    "status",
    "observation_count",
    "observations"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "instance_id": {
      "$ref": "#/$defs/uuid"
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]{0,63}$"
    },
    "started_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "completed_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "observation_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "factValue": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,63}$"
        }
      ]
    },
    "facts": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/factValue"
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_key",
        "observed_at",
        "state",
        "severity",
        "failure_code",
        "summary_code",
        "duration_ms",
        "facts"
      ],
      "properties": {
        "check_key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "observed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "unhealthy",
            "unknown"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "urgent",
            "critical"
          ]
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "summary_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "facts": {
          "$ref": "#/$defs/facts"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "healthy"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "info"
              },
              "failure_code": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "failure_code": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
