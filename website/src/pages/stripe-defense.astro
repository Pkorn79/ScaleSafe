---
import { BellRing, Check, FileInput, Gauge, Radar, ShieldCheck } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import CtaBand from "@components/CtaBand.astro";

const tools = [
  [BellRing, "Early warnings and dispute alerts", "See when a charge is flagged and make a deliberate refund decision before it becomes a formal chargeback where the alert program allows it."],
  [FileInput, "Evidence submission", "Compile the client record, review the response, and use ScaleSafe's supported Stripe evidence-submission workflow."],
  [Gauge, "Risk Health", "See dispute rate, evidence coverage, open exposure, reason trends, and practical actions in one place."],
  [Radar, "Radar and 3D Secure guidance", "Use stronger fraud checks on public checkout pages where strangers can pay without speaking to your team."],
];
---

<BaseLayout title="Stripe defense" description="Use ScaleSafe with Stripe early warnings, dispute alerts, Risk Health, Radar and 3D Secure guidance, and supported evidence submission.">
  <PageHero compact eyebrow="Stripe defense" title="Put the client record behind your Stripe response." lead="Alerts help you act earlier. Evidence helps you respond clearly. ScaleSafe connects both to the offer, agreement, payment, and fulfillment history behind the transaction." />

  <section class="tool-section"><div class="shell"><div class="section-heading"><p class="eyebrow">The useful layers</p><h2>Focus on the Stripe tools that fit high-ticket sales.</h2><p>Public checkout, mixed-ticket offers, early dispute handling, and complete evidence matter more here than a long list of ecommerce features.</p></div><div class="tool-grid">{tools.map(([Icon,title,body])=><article><Icon size={25}/><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>

  <section class="health-section"><div class="shell health-grid"><div><p class="eyebrow">Stripe Risk Health</p><h2>Know what needs attention before the next dispute.</h2><p>ScaleSafe turns the Stripe signals and client evidence it can observe into an operating view: dispute rate, evidence completeness, exposure, repeat-client history, and recommended actions.</p><p class="test-note">The PMG test account shown here is intentionally loaded with test disputes and incomplete historical records. That makes the warnings visible for product certification.</p></div><figure><div class="product-frame"><img src="/images/product/stripe-risk-health-live.png" alt="ScaleSafe Stripe Risk Health dashboard with dispute rate and recommended actions" width="1908" height="1008" loading="lazy"/></div><figcaption class="image-caption">Risk Health shows where the account record is strong and where the merchant should act.</figcaption></figure></div></section>

  <section class="submission-section"><div class="shell submission-grid"><div><p class="eyebrow">Supported evidence submission</p><h2>Review the case before sending it.</h2><p>ScaleSafe prepares the reason-specific letter and exhibits from the matching client program. The merchant can review and edit the response before using the supported Stripe submission path.</p><ul class="plain-list plain-list--dark"><li><Check size={18}/>Start from the disputed transaction</li><li><Check size={18}/>Use the card-brand reason code to organize the response</li><li><Check size={18}/>Hold incomplete or uncertain packets for review</li><li><Check size={18}/>Keep Stripe's response with the case history</li></ul></div><figure><div class="product-frame"><img src="/images/product/defense-letter-active.png" alt="ScaleSafe defense letter prepared for Stripe review" width="933" height="883" loading="lazy"/></div><figcaption class="image-caption">The merchant reviews the letter and evidence before submission.</figcaption></figure></div></section>

  <section class="boundary-section"><div class="shell"><ShieldCheck size={30}/><div><h2>Stripe still controls Stripe.</h2><p>Stripe and the card networks decide how Radar, 3D Secure, alerts, dispute windows, and evidence requirements work. ScaleSafe helps you configure the useful layers, organize the client record, and use supported submission tools.</p></div></div></section>
  <CtaBand title="Put stronger records behind your Stripe account." />
</BaseLayout>

<style>
  .tool-section,.health-section,.submission-section,.boundary-section{padding:110px 0}.tool-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.tool-grid article{min-height:310px;padding:30px 26px;border-right:1px solid var(--line)}.tool-grid article:last-child{border-right:0}.tool-grid svg{margin-bottom:48px;color:var(--teal)}.tool-grid p{color:var(--slate)}
  .health-section{background:var(--mist)}.health-grid,.submission-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:76px;align-items:center}.health-grid>div>p:not(.eyebrow),.submission-grid>div>p:not(.eyebrow){color:var(--slate);font-size:1.08rem}.health-grid figure,.submission-grid figure{margin:0}.health-grid .product-frame{aspect-ratio:1.78}.test-note{padding:16px;border-left:3px solid var(--warm);background:#fff9ec;font-size:.9rem!important}
  .submission-section{color:var(--white);background:var(--ink)}.submission-grid>div>p:not(.eyebrow),.submission-section .image-caption{color:var(--slate-light)}.submission-grid .product-frame{aspect-ratio:1.06}.plain-list--dark li{border-color:rgba(255,255,255,.15)}.plain-list--dark svg{color:var(--mint)}
  .boundary-section{background:var(--attention-bg)}.boundary-section>.shell{display:grid;grid-template-columns:54px 1fr;gap:20px;max-width:960px}.boundary-section svg{margin-top:8px;color:var(--attention)}.boundary-section p{color:var(--slate);font-size:1.08rem}
  @media(max-width:900px){.tool-grid{grid-template-columns:1fr 1fr}.tool-grid article:nth-child(2){border-right:0}.health-grid,.submission-grid{grid-template-columns:1fr;gap:46px}}
  @media(max-width:560px){.tool-section,.health-section,.submission-section,.boundary-section{padding:82px 0}.tool-grid{grid-template-columns:1fr}.tool-grid article,.tool-grid article:nth-child(2){min-height:0;border-right:0;border-bottom:1px solid var(--line)}.tool-grid svg{margin-bottom:28px}.boundary-section>.shell{grid-template-columns:38px 1fr}}
</style>
