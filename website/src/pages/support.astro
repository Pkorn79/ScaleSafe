---
import { BookOpen, Bug, CircleQuestionMark, Mail, Rocket, ShieldCheck, Workflow } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";

const resources = [
  { Icon: Rocket, title: "Getting started", body: "Install ScaleSafe, complete the account setup, configure the first offer, and run one checkout.", href: "/getting-started", featured: true },
  { Icon: Workflow, title: "What ScaleSafe sends", body: "Review the installed workflows, timing, consent clauses, and safe ways to prevent duplicate messages.", href: "/automations", featured: true },
  { Icon: BookOpen, title: "User guide", body: "Follow the merchant workflow from setup through offers, clients, payments, evidence, and defense.", href: "/guide" },
  { Icon: CircleQuestionMark, title: "Frequently asked questions", body: "Find direct answers about installation, payment channels, evidence, packet states, and integrations.", href: "/faq" },
  { Icon: Bug, title: "Troubleshooting", body: "Start with the symptom and prove each layer before reinstalling, retrying, or changing production state.", href: "/troubleshooting" },
  { Icon: ShieldCheck, title: "Security and trust", body: "Review ScaleSafe boundaries for tenant isolation, credentials, public actions, evidence, and payment data.", href: "/security" },
];
---

<BaseLayout title="Support" description="ScaleSafe support, product guides, frequently asked questions, troubleshooting, and issue-reporting guidance.">
  <PageHero compact eyebrow="ScaleSafe support" title="Find the answer or give us enough context to trace it." lead="Use the guides for common product questions. When you contact support, include the sub-account, client, offer, processor, time, and safe payment reference connected to the issue." />
  <section class="resource-section"><div class="shell"><div class="resource-grid">{resources.map(({ Icon, title, body, href, featured }) => <a href={href} class:list={{ featured }}><Icon size={25}/><div><h2>{title}</h2><p>{body}</p><span>Open resource</span></div></a>)}</div></div></section>
  <section class="contact-section"><div class="shell contact-grid"><div><p class="eyebrow">Contact support</p><h2>Send enough context to trace the right record.</h2><p>Do not email full card numbers, bank details, passwords, API keys, webhook secrets, or access tokens.</p></div><div class="contact-box"><Mail size={28}/><h3>Email ScaleSafe support</h3><a href="mailto:support@scalesafe.app">support@scalesafe.app</a><ul><li>GHL sub-account and business name</li><li>Client and offer or enrollment</li><li>Processor and transaction or payment ID</li><li>Exact date, time, timezone, and visible error</li><li>What you expected and what happened instead</li></ul></div></div></section>
</BaseLayout>

<style>
  .resource-section,.contact-section{padding:110px 0}.resource-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.resource-grid>a{min-height:310px;padding:30px 25px;border-right:1px solid var(--line);color:var(--ink);text-decoration:none}.resource-grid>a:last-child{border-right:0}.resource-grid>a.featured{grid-column:1/-1;display:grid;grid-template-columns:60px 1fr;gap:24px;min-height:0;padding:32px;border-right:0;border-bottom:1px solid var(--line);background:var(--mist)}.resource-grid>a.featured svg{margin:4px 0 0}.resource-grid>a.featured h2{font-size:1.8rem}.resource-grid>a.featured p{max-width:760px}.resource-grid svg{margin-bottom:46px;color:var(--teal)}.resource-grid h2{font-size:1.4rem}.resource-grid p{color:var(--slate)}.resource-grid span{color:var(--teal);font-weight:700}.contact-section{background:var(--mist)}.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:80px;align-items:start}.contact-grid>div:first-child>p:not(.eyebrow){color:var(--slate);font-size:1.08rem}.contact-box{padding:34px;border:1px solid var(--line);border-radius:var(--radius);background:var(--white)}.contact-box>svg{color:var(--teal)}.contact-box h3{margin:20px 0 6px}.contact-box>a{color:var(--teal);font-size:1.15rem;font-weight:700}.contact-box ul{margin:26px 0 0;padding-left:1.25rem;color:var(--slate)}@media(max-width:900px){.resource-grid{grid-template-columns:1fr 1fr}.resource-grid>a:nth-child(even):not(.featured){border-right:0}.contact-grid{grid-template-columns:1fr;gap:42px}}@media(max-width:560px){.resource-section,.contact-section{padding:82px 0}.resource-grid{grid-template-columns:1fr}.resource-grid>a,.resource-grid>a:nth-child(even):not(.featured){min-height:0;border-right:0;border-bottom:1px solid var(--line)}.resource-grid>a.featured{grid-template-columns:1fr;gap:8px;padding:28px 22px}.resource-grid>a.featured svg,.resource-grid svg{margin-bottom:20px}}
</style>
