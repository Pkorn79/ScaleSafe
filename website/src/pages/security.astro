---
import { Check, DatabaseBackup, EyeOff, KeyRound, LockKeyhole, ShieldCheck } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import CtaBand from "@components/CtaBand.astro";

const controls = [
  [LockKeyhole,"Sub-account isolation","Every merchant session and record stays bound to the GoHighLevel sub-account that opened ScaleSafe."],
  [KeyRound,"Credential protection","Processor and provider credentials are encrypted or hashed. Raw keys are not shown in merchant records."],
  [ShieldCheck,"Verified public actions","Signed links, verified webhooks, Turnstile, rate limits, and duplicate-action protection help secure public checkout and client actions."],
  [EyeOff,"Data minimization","Public pages, logs, diagnostics, and support views avoid raw card data, secrets, private file links, and unnecessary client information."],
  [DatabaseBackup,"Recovery controls","Application backups, database backups, migrations, and off-platform recovery procedures protect different parts of the system."],
];
---

<BaseLayout title="Security and trust" description="Review how ScaleSafe isolates merchant accounts, protects credentials, secures public actions, limits sensitive data, and prepares for recovery.">
  <PageHero compact eyebrow="Security and trust" title="Protect the merchant account and the client record." lead="ScaleSafe handles payment references, consent, communications, fulfillment records, and dispute evidence. The product is designed to keep each merchant separate and expose only the data needed for the job." />
  <section class="controls-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Core controls</p><h2>Security is enforced in the workflow, not added as a badge.</h2><p>These controls describe the product architecture. They are not a claim of an external certification that ScaleSafe has not completed.</p></div><div class="control-list">{controls.map(([Icon,title,body])=><article><Icon size={24}/><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
  <section class="boundaries-section"><div class="shell boundaries-grid"><div><p class="eyebrow">Payment boundaries</p><h2>ScaleSafe does not store raw card or bank credentials.</h2><p>Card and bank collection uses processor-hosted fields, tokens, vault references, or hosted checkout. ScaleSafe records safe payment identifiers and masked metadata needed to manage the enrollment.</p></div><div><p class="eyebrow">Defense boundaries</p><h2>A packet must still earn the Ready state.</h2><p>Unknown reason codes, ambiguous enrollment scope, missing signed packet files, and AI fallback can force manual review. ScaleSafe does not label a packet ready merely because a document was generated.</p></div></div></section>
  <section class="trust-section"><div class="shell trust-grid"><div><h2>What ScaleSafe does not claim</h2></div><ul><li><Check size={18}/>No guarantee that every dispute will be prevented or won</li><li><Check size={18}/>No claim to be a bank, processor, acquirer, card network, law firm, or merchant of record</li><li><Check size={18}/>No "court-grade," "bank-grade," or "tamper-proof" evidence claim</li><li><Check size={18}/>No unsupported compliance certification</li></ul></div></section>
  <CtaBand title="Ask the security questions before connecting the data." />
</BaseLayout>

<style>
  .controls-section,.boundaries-section,.trust-section{padding:110px 0}.control-list{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line)}.control-list article{min-height:310px;padding:30px 22px;border-right:1px solid var(--line)}.control-list article:last-child{border-right:0}.control-list svg{margin-bottom:44px;color:var(--teal)}.control-list p,.boundaries-grid p{color:var(--slate)}.boundaries-section{background:var(--mist)}.boundaries-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:80px}.boundaries-grid>div+div{padding-left:80px;border-left:1px solid var(--line)}.trust-section{color:var(--white);background:var(--ink)}.trust-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.trust-grid h2{margin:0}.trust-grid ul{margin:0;padding:0;list-style:none}.trust-grid li{display:flex;gap:10px;padding:13px 0;border-top:1px solid rgba(255,255,255,.15);color:#d6e1e8}.trust-grid li svg{color:var(--mint);flex:0 0 auto}@media(max-width:980px){.control-list{grid-template-columns:1fr 1fr}.control-list article:nth-child(even){border-right:0}.control-list article:last-child{grid-column:1/-1;border-top:1px solid var(--line)}.boundaries-grid,.trust-grid{grid-template-columns:1fr;gap:42px}.boundaries-grid>div+div{padding:42px 0 0;border-left:0;border-top:1px solid var(--line)}}@media(max-width:560px){.controls-section,.boundaries-section,.trust-section{padding:82px 0}.control-list{grid-template-columns:1fr}.control-list article,.control-list article:nth-child(even),.control-list article:last-child{grid-column:auto;min-height:0;border-right:0;border-bottom:1px solid var(--line)}.control-list svg{margin-bottom:26px}}
</style>
