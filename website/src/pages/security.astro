---
import { DatabaseBackup, EyeOff, KeyRound, LockKeyhole, ShieldCheck } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import CtaBand from "@components/CtaBand.astro";

const controls = [
  [LockKeyhole,"Sub-account isolation","Every merchant session and record stays bound to the GoHighLevel sub-account that opened ScaleSafe."],
  [KeyRound,"Credential protection","Processor and provider credentials are encrypted or hashed, while merchant records show only safe connection details."],
  [ShieldCheck,"Verified public actions","Signed links, verified webhooks, Turnstile, rate limits, and duplicate-action protection help secure public checkout and client actions."],
  [EyeOff,"Data minimization","Public pages, logs, diagnostics, and support views use masked payment details and the minimum client information needed for the task."],
  [DatabaseBackup,"Recovery controls","Application backups, database backups, migrations, and off-platform recovery procedures protect different parts of the system."],
];
---

<BaseLayout title="Security and trust" description="Review how ScaleSafe isolates merchant accounts, protects credentials, secures public actions, limits sensitive data, and prepares for recovery.">
  <PageHero compact eyebrow="Security and trust" title="Protect the merchant account and the client record." lead="ScaleSafe handles payment references, consent, communications, fulfillment records, and dispute evidence. The product is designed to keep each merchant separate and expose only the data needed for the job." />
  <section class="controls-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Core controls</p><h2>Security follows every merchant workflow.</h2><p>ScaleSafe combines tenant isolation, protected credentials, verified public actions, data minimization, and recovery controls across the product.</p></div><div class="control-list">{controls.map(([Icon,title,body])=><article><Icon size={24}/><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
  <section class="boundaries-section"><div class="shell boundaries-grid"><div><p class="eyebrow">Payment protection</p><h2>Payment collection stays with the provider.</h2><p>Card and bank collection uses processor-hosted fields, tokens, vault references, or hosted checkout. ScaleSafe records masked payment identifiers needed to manage the enrollment.</p></div><div><p class="eyebrow">Defense review</p><h2>Evidence checks guide the Ready status.</h2><p>ScaleSafe checks the transaction, enrollment, signed files, reason code, and draft before presenting the packet for merchant review.</p></div></div></section>
  <CtaBand title="Connect client records with confidence." />
</BaseLayout>

<style>
  .controls-section,.boundaries-section{padding:110px 0}.control-list{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line)}.control-list article{min-height:310px;padding:30px 22px;border-right:1px solid var(--line)}.control-list article:last-child{border-right:0}.control-list svg{margin-bottom:44px;color:var(--teal)}.control-list p,.boundaries-grid p{color:var(--slate)}.boundaries-section{background:var(--mist)}.boundaries-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:80px}.boundaries-grid>div+div{padding-left:80px;border-left:1px solid var(--line)}@media(max-width:980px){.control-list{grid-template-columns:1fr 1fr}.control-list article:nth-child(even){border-right:0}.control-list article:last-child{grid-column:1/-1;border-top:1px solid var(--line)}.boundaries-grid{grid-template-columns:1fr;gap:42px}.boundaries-grid>div+div{padding:42px 0 0;border-left:0;border-top:1px solid var(--line)}}@media(max-width:560px){.controls-section,.boundaries-section{padding:82px 0}.control-list{grid-template-columns:1fr}.control-list article,.control-list article:nth-child(even),.control-list article:last-child{grid-column:auto;min-height:0;border-right:0;border-bottom:1px solid var(--line)}.control-list svg{margin-bottom:26px}}
</style>
