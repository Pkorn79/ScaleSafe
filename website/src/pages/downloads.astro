---
import {
  ArrowRight,
  CircleCheck,
  Copy,
  Download,
  MessageSquareText,
  PanelsTopLeft,
  ShieldCheck,
  Terminal,
  Workflow,
} from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const products = [
  {
    id: "operator",
    eyebrow: "Operate your business",
    title: "HighLevel + ScaleSafe Operator",
    description: "Audit, build, and improve one HighLevel sub-account, then carry sold clients through ScaleSafe enrollment, payment, and fulfillment evidence.",
    icon: Workflow,
    prompt: "Use the HighLevel + ScaleSafe operator skill. Keep replies short and ask one question at a time. First check my HighLevel and browser connections, then help me choose the next safe step. Do not change anything until I approve the exact action.",
    downloads: [
      {
        platform: "Claude",
        format: "Skill ZIP",
        icon: MessageSquareText,
        description: "For Claude on the web and Claude Cowork. Use Cowork when the task needs supervised browser control.",
        href: "/downloads/operate-highlevel-scalesafe-claude.zip",
        size: "70 KB",
        checksum: "FFCFBDBF5E891D5C9C19DB7F2B0B0DDC6D4979E4A9CFEF153EBFE42892D4AE27",
        steps: [
          "Open Claude, then go to Customize and Skills.",
          "Upload the ZIP without extracting it.",
          "For browser work, open Cowork and enable Claude in Chrome or Control Chrome.",
        ],
      },
      {
        platform: "OpenAI Codex",
        format: "Plugin ZIP",
        icon: Terminal,
        description: "For Codex desktop. The package includes the operator skill and its HighLevel connection requirement.",
        href: "/downloads/operate-highlevel-scalesafe-codex.zip",
        size: "73 KB",
        checksum: "ED3DE3932C7B0DEA3DDCAD09CA30CF6AA10312CEDB10AB0C1733D1934ABC8A18",
        steps: [
          "Download and extract the ZIP to a folder you control.",
          "Open that folder in Codex and install HighLevel + ScaleSafe Operator from Plugins.",
          "Connect HighLevel and enable Control Chrome or the in-app Browser when needed.",
        ],
      },
    ],
  },
  {
    id: "web-builder",
    eyebrow: "Build your website",
    title: "Web Builder",
    description: "Create or improve a polished business site, verify it on desktop and mobile, and publish it through the hosting project you approve.",
    proof: "The ScaleSafe site you are viewing was built with the workflow now packaged as Web Builder.",
    icon: PanelsTopLeft,
    prompt: "Use the Web Builder skill. Keep replies short and ask only one question at a time. Build the smallest polished website that achieves my goal, verify it on desktop and mobile, and do not publish until I approve the exact destination.",
    downloads: [
      {
        platform: "Claude",
        format: "Skill ZIP",
        icon: MessageSquareText,
        description: "For Claude on the web, Cowork, or Claude Code. Use a workspace with file and browser access for a complete build.",
        href: "/downloads/web-builder-claude.zip",
        size: "11 KB",
        checksum: "B5C110B4C4713D229D1A6EFD9E4164A607A5978CEBAD7AB9C4CE223F614421BE",
        steps: [
          "Open Claude, then go to Customize and Skills.",
          "Upload the ZIP without extracting it.",
          "Open Cowork or Claude Code with your project folder when you are ready to build.",
        ],
      },
      {
        platform: "OpenAI Codex",
        format: "Plugin ZIP",
        icon: Terminal,
        description: "For Codex desktop. It adapts to an existing site or creates a maintainable new one from your business brief.",
        href: "/downloads/web-builder-codex.zip",
        size: "13 KB",
        checksum: "338696DD441EFD80EC882A05F3B0696002207401A65B6D72B5683701931011B9",
        steps: [
          "Download and extract the ZIP to a folder you control.",
          "Open that folder in Codex and install Web Builder from Plugins.",
          "Open your website folder, or an empty folder for a new site, and start with the prompt below.",
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="AI skill downloads"
  description="Download the ScaleSafe HighLevel operator and Web Builder for Claude or OpenAI Codex."
  noindex
>
  <section class="download-hero">
    <div class="shell download-hero__inner">
      <div class="download-hero__copy">
        <p class="eyebrow">ScaleSafe AI kits</p>
        <h1>Build your site. Run your systems. Use plain language.</h1>
        <p>Choose a practical workflow and the AI workspace you already use. Each kit turns a complex job into a supervised conversation.</p>
      </div>
      <div class="hero-proof" aria-label="Available AI kits">
        <span><CircleCheck size={18} /> Web Builder</span>
        <span><CircleCheck size={18} /> HighLevel + ScaleSafe</span>
        <span><CircleCheck size={18} /> Claude + Codex</span>
      </div>
    </div>
  </section>

  {products.map((product, productIndex) => {
    const ProductIcon = product.icon;
    return (
      <section class:list={["product-section", { "product-section--alternate": productIndex % 2 === 1 }]} aria-labelledby={`${product.id}-title`}>
        <div class="shell">
          <div class="product-heading">
            <span class="product-icon" aria-hidden="true"><ProductIcon size={28} stroke-width={1.8} /></span>
            <div>
              <p class="eyebrow">{product.eyebrow}</p>
              <h2 id={`${product.id}-title`}>{product.title}</h2>
              <p>{product.description}</p>
            </div>
          </div>

          {product.proof && (
            <div class="built-here">
              <PanelsTopLeft size={22} />
              <p><strong>Built here.</strong> {product.proof}</p>
            </div>
          )}

          <div class="download-grid">
            {product.downloads.map((item) => {
              const PlatformIcon = item.icon;
              return (
                <article class="download-option">
                  <div class="download-option__top">
                    <span class="platform-icon" aria-hidden="true"><PlatformIcon size={26} stroke-width={1.8} /></span>
                    <div>
                      <p class="file-type">{item.format}</p>
                      <h3>{item.platform}</h3>
                    </div>
                  </div>
                  <p class="download-description">{item.description}</p>
                  <ol class="install-steps">
                    {item.steps.map((step) => <li>{step}</li>)}
                  </ol>
                  <a class="button download-button" href={item.href} download>
                    <Download size={18} /> Download for {item.platform}
                  </a>
                  <div class="file-details">
                    <span>ZIP / {item.size}</span>
                    <details>
                      <summary>Verify file</summary>
                      <p><strong>SHA-256</strong><code>{item.checksum}</code></p>
                    </details>
                  </div>
                </article>
              );
            })}
          </div>

          <div class="prompt-row">
            <div>
              <p class="eyebrow">Your first message</p>
              <h3>Start with one clear request.</h3>
            </div>
            <div class="prompt-panel">
              <p class="prompt-text">{product.prompt}</p>
              <button class="copy-button" type="button" data-copy-prompt>
                <Copy size={18} /> Copy starter prompt
              </button>
              <span class="copy-status" aria-live="polite"></span>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="before-section" aria-labelledby="before-title">
    <div class="shell">
      <div class="section-heading compact-heading">
        <p class="eyebrow">Before the first run</p>
        <h2 id="before-title">Give the AI the right workspace.</h2>
      </div>
      <div class="readiness-grid">
        <div>
          <span class="step-number">01</span>
          <h3>Install one package</h3>
          <p>Choose the Claude skill or Codex plugin for the workspace you plan to use.</p>
        </div>
        <div>
          <span class="step-number">02</span>
          <h3>Connect what it needs</h3>
          <p>Use Cowork, Claude Code, or Codex when the job needs project files, browser control, or deployment access.</p>
        </div>
        <div>
          <span class="step-number">03</span>
          <h3>Approve external actions</h3>
          <p>The skills prepare and verify work first. You approve publishing, account changes, sends, and charges.</p>
        </div>
      </div>
      <div class="connection-note">
        <ShieldCheck size={22} />
        <p><strong>No credentials are included.</strong> Each person connects their own accounts and confirms the exact destination before the AI reads private data or publishes anything.</p>
      </div>
    </div>
  </section>

  <section class="support-band">
    <div class="shell support-band__inner">
      <div>
        <p class="eyebrow">ScaleSafe private beta</p>
        <h2>Need access or personal setup help?</h2>
        <p>The operator kit is included for beta participants. Personalized installation, troubleshooting, and website setup are available separately.</p>
      </div>
      <a class="button" href="/beta">Request access <ArrowRight size={18} /></a>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll("[data-copy-prompt]").forEach((button) => {
      button.addEventListener("click", async () => {
        const panel = button.closest(".prompt-panel");
        const prompt = panel?.querySelector(".prompt-text");
        const status = panel?.querySelector(".copy-status");
        if (!prompt || !status) return;

        try {
          await navigator.clipboard.writeText(prompt.textContent?.trim() || "");
          status.textContent = "Copied";
          window.setTimeout(() => { status.textContent = ""; }, 1800);
        } catch {
          status.textContent = "Select the prompt and copy it manually.";
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .download-hero{padding:82px 0 72px;color:var(--white);background:var(--ink)}
  .download-hero__inner{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.5fr);gap:72px;align-items:end}
  .download-hero__copy{max-width:900px}.download-hero h1{max-width:960px;margin-bottom:24px;font-size:clamp(3rem,5.5vw,5.2rem)}
  .download-hero__copy>p:last-child{max-width:720px;margin-bottom:0;color:#c6d5df;font-size:1.15rem}
  .download-hero .eyebrow,.support-band .eyebrow{color:var(--mint)}
  .hero-proof{display:grid;gap:0;border-top:1px solid rgba(255,255,255,.18)}
  .hero-proof span{display:flex;align-items:center;gap:9px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.18);font-weight:600}
  .hero-proof svg{color:var(--mint);flex:0 0 auto}

  .product-section{padding:100px 0;background:var(--mist)}.product-section--alternate{background:var(--white)}
  .product-heading{display:grid;grid-template-columns:62px minmax(0,760px);gap:20px;align-items:start;margin-bottom:40px}.product-heading .eyebrow{margin:4px 0 12px}.product-heading h2{margin-bottom:16px;font-size:clamp(2.5rem,4.4vw,4rem)}.product-heading>div>p:last-child{margin:0;color:var(--slate);font-size:1.08rem}
  .product-icon{display:grid;width:62px;height:62px;place-items:center;border-radius:8px;color:var(--white);background:var(--blue)}
  .built-here{display:flex;align-items:flex-start;gap:12px;margin:-12px 0 32px 82px;padding:17px 20px;border-left:4px solid var(--mint);background:#e8f7f3}.built-here svg{flex:0 0 auto;color:var(--mint-dark)}.built-here p{margin:0}
  .download-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
  .download-option{display:flex;min-width:0;flex-direction:column;padding:32px;border:1px solid var(--line);border-radius:var(--radius);background:var(--white);box-shadow:0 14px 36px rgba(7,25,45,.08)}.product-section--alternate .download-option{background:var(--mist)}
  .download-option__top{display:flex;align-items:center;gap:14px;margin-bottom:20px}.platform-icon{display:grid;width:52px;height:52px;flex:0 0 52px;place-items:center;border-radius:6px;color:var(--white);background:var(--blue)}
  .file-type{margin:0 0 2px;color:var(--teal);font-size:.76rem;font-weight:700;text-transform:uppercase}.download-option h3{margin:0;font-size:1.8rem}.download-description{min-height:78px;color:var(--slate)}
  .install-steps{margin:8px 0 26px;padding:0;list-style:none;counter-reset:steps}.install-steps li{position:relative;min-height:46px;padding:10px 0 10px 38px;border-top:1px solid var(--line);counter-increment:steps}
  .install-steps li::before{content:counter(steps);position:absolute;left:0;top:10px;display:grid;width:24px;height:24px;place-items:center;border-radius:50%;color:var(--ink);background:var(--warm);font-size:.72rem;font-weight:800}
  .download-button{width:100%;margin-top:auto}.file-details{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-top:15px;color:var(--slate);font-size:.78rem}.file-details details{text-align:right}.file-details summary{cursor:pointer;font-weight:700}.file-details p{position:absolute;z-index:2;width:min(440px,calc(100vw - 40px));margin:8px 0 0;right:max(20px,calc((100vw - min(calc(100vw - 40px),1200px))/2));padding:12px;border:1px solid var(--line);border-radius:6px;text-align:left;background:var(--white);box-shadow:var(--shadow)}.file-details code{display:block;overflow-wrap:anywhere;margin-top:4px;color:var(--ink);font-size:.72rem}
  .prompt-row{display:grid;grid-template-columns:.55fr 1.45fr;gap:48px;align-items:center;margin-top:32px;padding-top:32px;border-top:1px solid var(--line)}.prompt-row .eyebrow{margin-bottom:10px}.prompt-row h3{margin:0;font-size:1.55rem}
  .prompt-panel{padding:24px;border-left:5px solid var(--warm);background:var(--ink)}.prompt-panel>p{margin-bottom:20px;color:var(--white);font-size:1rem}.copy-button{display:inline-flex;min-height:44px;align-items:center;gap:8px;padding:0 15px;border:1px solid var(--mint);border-radius:6px;color:var(--ink);background:var(--mint);font-weight:700;cursor:pointer}.copy-button:hover{background:#36c8ac}.copy-status{margin-left:10px;color:#c6d5df;font-size:.82rem}

  .compact-heading{margin-bottom:38px}.compact-heading h2{font-size:clamp(2.3rem,4vw,3.6rem)}
  .before-section{padding:96px 0;background:#eaf1f3}.readiness-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-block:1px solid #c5d3d9}.readiness-grid>div{padding:30px 30px 30px 0}.readiness-grid>div+div{padding-left:30px;border-left:1px solid #c5d3d9}.step-number{display:block;margin-bottom:20px;color:var(--attention);font-family:var(--font-display);font-size:.86rem;font-weight:800}.readiness-grid h3{margin-bottom:10px}.readiness-grid p{margin:0;color:var(--slate)}
  .connection-note{display:flex;align-items:flex-start;gap:12px;margin-top:28px;padding:18px 20px;border:1px solid #e5c1b8;border-radius:var(--radius);background:var(--attention-bg)}.connection-note svg{flex:0 0 auto;color:var(--attention)}.connection-note p{margin:0}
  .support-band{padding:76px 0;color:var(--white);background:var(--blue)}.support-band__inner{display:flex;align-items:center;justify-content:space-between;gap:60px}.support-band h2{max-width:750px;margin-bottom:16px;font-size:clamp(2.2rem,4vw,3.5rem)}.support-band p:last-child{max-width:760px;margin:0;color:#c9d7e1}.support-band .button{flex:0 0 auto}

  @media(max-width:900px){.download-hero__inner{grid-template-columns:1fr;gap:42px}.download-grid{grid-template-columns:1fr}.download-description{min-height:0}.file-details p{right:20px}.prompt-row{grid-template-columns:1fr;gap:20px}.readiness-grid{grid-template-columns:1fr;border-block:0}.readiness-grid>div{padding:24px 0;border-top:1px solid #c5d3d9}.readiness-grid>div+div{padding-left:0;border-left:0}.readiness-grid>div:last-child{border-bottom:1px solid #c5d3d9}.support-band__inner{align-items:flex-start;flex-direction:column;gap:28px}}
  @media(max-width:560px){.download-hero{padding:58px 0}.download-hero h1{font-size:2.75rem}.product-section,.before-section{padding:76px 0}.product-heading{grid-template-columns:1fr;gap:16px}.built-here{margin:0 0 28px}.download-option{padding:24px 20px}.file-details{align-items:flex-start;flex-direction:column}.file-details details{text-align:left}.file-details p{left:20px;right:auto}.copy-status{display:block;margin:10px 0 0}.support-band{padding:66px 0}}
</style>
