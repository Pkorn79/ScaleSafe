---
import {
  ArrowRight,
  CircleCheck,
  Copy,
  Download,
  MessageSquareText,
  PanelsTopLeft,
  ShieldCheck,
  Terminal,
  Workflow,
} from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const products = [
  {
    id: "operator",
    eyebrow: "Operate your business",
    title: "HighLevel + ScaleSafe Operator",
    description: "Audit, build, and improve one HighLevel sub-account, then carry sold clients through ScaleSafe enrollment, payment, and fulfillment evidence.",
    icon: Workflow,
    prompt: "Use the HighLevel + ScaleSafe operator skill. Keep replies short and ask one question at a time. First check my HighLevel and browser connections, then help me choose the next safe step. Do not change anything until I approve the exact action.",
    downloads: [
      {
        platform: "Claude",
        format: "Skill ZIP",
        icon: MessageSquareText,
        description: "For Claude on the web and Claude Cowork. Use Cowork when the task needs supervised browser control.",
        size: "70 KB",
        checksum: "FFCFBDBF5E891D5C9C19DB7F2B0B0DDC6D4979E4A9CFEF153EBFE42892D4AE27",
        steps: [
          "Open Claude, then go to Customize and Skills.",
          "Upload the ZIP without extracting it.",
          "For browser work, open Cowork and enable Claude in Chrome or Control Chrome.",
        ],
      },
      {
        platform: "OpenAI Codex",
        format: "Toolkit ZIP",
        icon: Terminal,
        description: "One local ScaleSafe marketplace containing both Codex plugins. Install the operator, Web Builder, or both.",
        size: "85 KB",
        checksum: "93B681BDD1E0992F4DCC0063FE6ABA1A438858A0BF3530A6D87BAB89C2A9CDE5",
        steps: [
          "Download and extract the toolkit to a permanent folder.",
          "Open that folder in Codex, restart Codex, then open Plugins and choose ScaleSafe.",
          "Install either or both plugins, start a new task, and connect HighLevel or browser tools when needed.",
        ],
      },
    ],
  },
  {
    id: "web-builder",
    eyebrow: "Build your website",
    title: "Web Builder",
    description: "Create or improve a polished business site, verify it on desktop and mobile, and publish it through the hosting project you approve.",
    proof: "The ScaleSafe site you are viewing was built with the workflow now packaged as Web Builder.",
    icon: PanelsTopLeft,
    prompt: "Use the Web Builder skill. Keep replies short and ask only one question at a time. Build the smallest polished website that achieves my goal, verify it on desktop and mobile, and do not publish until I approve the exact destination.",
    downloads: [
      {
        platform: "Claude",
        format: "Skill ZIP",
        icon: MessageSquareText,
        description: "For Claude on the web, Cowork, or Claude Code. Use a workspace with file and browser access for a complete build.",
        size: "11 KB",
        checksum: "B5C110B4C4713D229D1A6EFD9E4164A607A5978CEBAD7AB9C4CE223F614421BE",
        steps: [
          "Open Claude, then go to Customize and Skills.",
          "Upload the ZIP without extracting it.",
          "Open Cowork or Claude Code with your project folder when you are ready to build.",
        ],
      },
      {
        platform: "OpenAI Codex",
        format: "Toolkit ZIP",
        icon: Terminal,
        description: "One local ScaleSafe marketplace containing both Codex plugins. Install Web Builder, the operator, or both.",
        size: "85 KB",
        checksum: "93B681BDD1E0992F4DCC0063FE6ABA1A438858A0BF3530A6D87BAB89C2A9CDE5",
        steps: [
          "Download and extract the toolkit to a permanent folder.",
          "Open that folder in Codex, restart Codex, then open Plugins and choose ScaleSafe.",
          "Install either or both plugins, start a new task, then open your website folder when you are ready to build.",
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="AI skill downloads"
  description="Download the ScaleSafe HighLevel operator and Web Builder for Claude or OpenAI Codex."
  noindex
>
  <section class="download-hero">
    <div class="shell download-hero__inner">
      <div class="download-hero__copy">
        <p class="eyebrow">ScaleSafe AI kits</p>
        <h1>Build your site. Run your systems. Use plain language.</h1>
        <p>Choose a practical workflow and the AI workspace you already use. Each kit turns a complex job into a supervised conversation.</p>
      </div>
      <div class="hero-proof" aria-label="Available AI kits">
        <span><CircleCheck size={18} /> Web Builder</span>
        <span><CircleCheck size={18} /> HighLevel + ScaleSafe</span>
        <span><CircleCheck size={18} /> Claude + Codex</span>
      </div>
    </div>
  </section>

  <section class="workspace-choice" aria-labelledby="workspace-choice-title">
    <div class="shell">
      <div class="section-heading compact-heading">
        <p class="eyebrow">Choose the right workspace</p>
        <h2 id="workspace-choice-title">The names are similar. The jobs are different.</h2>
      </div>
      <div class="workspace-grid">
        <div>
          <span class="workspace-label">ChatGPT</span>
          <h3>General conversation</h3>
          <p>Use for everyday questions and planning. Do not upload these Claude or Codex ZIPs into a regular ChatGPT conversation.</p>
        </div>
        <div>
          <span class="workspace-label">Codex</span>
          <h3>Plugins and project work</h3>
          <p>Use the Codex toolkit when the AI needs installed workflows, local files, a terminal, browser control, testing, or publishing.</p>
        </div>
        <div>
          <span class="workspace-label">Claude</span>
          <h3>Skills in a conversation</h3>
          <p>Upload a Claude Skill ZIP under Customize and Skills. Use standard Claude for discovery, planning, guidance, and connected-tool work.</p>
        </div>
        <div>
          <span class="workspace-label">Claude Cowork</span>
          <h3>Claude with a workspace</h3>
          <p>Use the same uploaded Claude skill in Cowork when the task needs a selected folder, iterative file work, or supervised browser control.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="access-section" id="download-access" aria-labelledby="download-access-title">
    <div class="shell access-grid">
      <div class="access-copy">
        <p class="eyebrow">Free AI toolkit access</p>
        <h2 id="download-access-title">Enter your name and email once.</h2>
        <p>After you submit, we will open one private page with the Claude skills and Codex toolkit.</p>
        <ul>
          <li><CircleCheck size={18} /> HighLevel + ScaleSafe Operator</li>
          <li><CircleCheck size={18} /> Web Builder</li>
          <li><CircleCheck size={18} /> Claude and Codex packages</li>
        </ul>
      </div>
      <div class="access-form-wrap">
        <div class="form-loading" aria-hidden="true"><span></span><p>Loading the download form...</p></div>
        <iframe
          src="https://api.leadconnectorhq.com/widget/form/ZfI0HkLSbKgYfAbdPzuv"
          id="inline-ZfI0HkLSbKgYfAbdPzuv"
          class="ghl-form"
          title="AI Toolkit Download Access"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="AI Toolkit Download Access"
          data-height="560"
          data-layout-iframe-id="inline-ZfI0HkLSbKgYfAbdPzuv"
          data-form-id="ZfI0HkLSbKgYfAbdPzuv"
          onload="this.previousElementSibling?.classList.add('is-hidden')"
        ></iframe>
        <p class="form-note">We use your information to provide the toolkit and related updates. Review our <a href="/privacy">Privacy Policy</a>.</p>
      </div>
    </div>
  </section>

  {products.map((product, productIndex) => {
    const ProductIcon = product.icon;
    return (
      <section id={product.id} class:list={["product-section", { "product-section--alternate": productIndex % 2 === 1 }]} aria-labelledby={`${product.id}-title`}>
        <div class="shell">
          <div class="product-heading">
            <span class="product-icon" aria-hidden="true"><ProductIcon size={28} stroke-width={1.8} /></span>
            <div>
              <p class="eyebrow">{product.eyebrow}</p>
              <h2 id={`${product.id}-title`}>{product.title}</h2>
              <p>{product.description}</p>
            </div>
          </div>

          {product.proof && (
            <div class="built-here">
              <PanelsTopLeft size={22} />
              <p><strong>Built here.</strong> {product.proof}</p>
            </div>
          )}

          <div class="download-grid">
            {product.downloads.map((item) => {
              const PlatformIcon = item.icon;
              return (
                <article class="download-option">
                  <div class="download-option__top">
                    <span class="platform-icon" aria-hidden="true"><PlatformIcon size={26} stroke-width={1.8} /></span>
                    <div>
                      <p class="file-type">{item.format}</p>
                      <h3>{item.platform}</h3>
                    </div>
                  </div>
                  <p class="download-description">{item.description}</p>
                  <ol class="install-steps">
                    {item.steps.map((step) => <li>{step}</li>)}
                  </ol>
                  <a class="button download-button" href="#download-access">
                    <Download size={18} /> Get {item.platform} access
                  </a>
                  <div class="file-details">
                    <span>ZIP / {item.size}</span>
                    <details>
                      <summary>Verify file</summary>
                      <p><strong>SHA-256</strong><code>{item.checksum}</code></p>
                    </details>
                  </div>
                </article>
              );
            })}
          </div>

          <div class="prompt-row">
            <div>
              <p class="eyebrow">Your first message</p>
              <h3>Start with one clear request.</h3>
            </div>
            <div class="prompt-panel">
              <p class="prompt-text">{product.prompt}</p>
              <button class="copy-button" type="button" data-copy-prompt>
                <Copy size={18} /> Copy starter prompt
              </button>
              <span class="copy-status" aria-live="polite"></span>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="claude-install-section" aria-labelledby="claude-install-title">
    <div class="shell">
      <div class="section-heading compact-heading">
        <p class="eyebrow">Claude and Cowork setup</p>
        <h2 id="claude-install-title">Upload the skill once. Choose Claude or Cowork for the job.</h2>
        <p>Cowork uses the skill already attached to your Claude account. It does not require a second ZIP.</p>
      </div>

      <div class="claude-install-layout">
        <ol class="claude-install-steps">
          <li><strong>Download the Claude Skill ZIP.</strong><span>Choose the operator or Web Builder package. Do not extract it.</span></li>
          <li><strong>Open Claude, then Customize and Skills.</strong><span>Upload the ZIP and confirm the skill appears in your list.</span></li>
          <li><strong>Start a new Claude conversation.</strong><span>Name the skill in your first request and tell it the result you want.</span></li>
          <li><strong>Use Cowork for files or browser work.</strong><span>Open Claude Desktop, start a Cowork task, and use the same uploaded skill.</span></li>
          <li><strong>Enable browser control before browser work.</strong><span>In Claude settings, enable Claude in Chrome or the supported Control Chrome connector for that task.</span></li>
        </ol>

        <div class="claude-use-guide">
          <div>
            <p class="workspace-label">Use standard Claude</p>
            <p>Interviews, workflow discovery, blueprints, explanations, and work the connected MCP can complete without a visual builder.</p>
          </div>
          <div>
            <p class="workspace-label">Use Claude Cowork</p>
            <p>Funnel and workflow builders, screenshots, selected folders, website files, and other work that needs supervised browser or file access.</p>
          </div>
          <p class="claude-connection-note"><strong>Connections are separate.</strong> The skill does not automatically authorize HighLevel, Chrome, email, hosting, or payment accounts.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="codex-install-section" aria-labelledby="codex-install-title">
    <div class="shell">
      <div class="section-heading compact-heading">
        <p class="eyebrow">OpenAI Codex setup</p>
        <h2 id="codex-install-title">Install once. Load a plugin in every new task.</h2>
        <p>The Codex toolkit contains both plugins. Install either one or both from the same ScaleSafe marketplace.</p>
      </div>

      <div class="codex-install-layout">
        <ol class="codex-install-steps">
          <li><strong>Download and extract the toolkit.</strong><span>Keep the extracted folder somewhere permanent.</span></li>
          <li><strong>Open that folder in Codex.</strong><span>Use Open Folder and select the top-level extracted folder.</span></li>
          <li><strong>Fully close and reopen Codex.</strong><span>This refreshes local plugin marketplaces.</span></li>
          <li><strong>Open Plugins, then choose ScaleSafe.</strong><span>Click + on HighLevel + ScaleSafe Operator, Web Builder, or both.</span></li>
          <li><strong>Start a new task.</strong><span>Newly installed plugins are loaded when the new task starts.</span></li>
          <li><strong>Type @ in the prompt box.</strong><span>Select the plugin, write the result you want, and send the request.</span></li>
        </ol>

        <div class="invoke-panel">
          <p class="eyebrow">Inside a new task</p>
          <h3>Choose the plugin with @</h3>
          <p>After selecting <strong>HighLevel + ScaleSafe Operator</strong>, try:</p>
          <blockquote>Audit my ScaleSafe test account. Keep this read-only and keep your answers short.</blockquote>
          <p>After selecting <strong>Web Builder</strong>, try:</p>
          <blockquote>Build a simple website for my business. Ask one question at a time.</blockquote>
        </div>
      </div>

      <details class="codex-fallback">
        <summary>ScaleSafe does not appear under Plugins</summary>
        <p>Open a terminal in Codex, register the extracted toolkit folder, restart Codex, and check Plugins again:</p>
        <code>codex plugin marketplace add "&lt;full path to the extracted toolkit folder&gt;"</code>
      </details>
    </div>
  </section>

  <section class="before-section" aria-labelledby="before-title">
    <div class="shell">
      <div class="section-heading compact-heading">
        <p class="eyebrow">Before the first run</p>
        <h2 id="before-title">Give the AI the right workspace.</h2>
      </div>
      <div class="readiness-grid">
        <div>
          <span class="step-number">01</span>
          <h3>Install one package</h3>
          <p>Choose the Claude skill or the combined Codex toolkit for the workspace you plan to use.</p>
        </div>
        <div>
          <span class="step-number">02</span>
          <h3>Connect what it needs</h3>
          <p>Use Cowork, Claude Code, or Codex when the job needs project files, browser control, or deployment access.</p>
        </div>
        <div>
          <span class="step-number">03</span>
          <h3>Approve external actions</h3>
          <p>The skills prepare and verify work first. You approve publishing, account changes, sends, and charges.</p>
        </div>
      </div>
      <div class="connection-note">
        <ShieldCheck size={22} />
        <p><strong>No credentials are included.</strong> Each person connects their own accounts and confirms the exact destination before the AI reads private data or publishes anything.</p>
      </div>
    </div>
  </section>

  <section class="support-band">
    <div class="shell support-band__inner">
      <div>
        <p class="eyebrow">ScaleSafe private beta</p>
        <h2>Need access or personal setup help?</h2>
        <p>The operator kit is included for beta participants. Personalized installation, troubleshooting, and website setup are available separately.</p>
      </div>
      <a class="button" href="/beta">Request access <ArrowRight size={18} /></a>
    </div>
  </section>

  <script is:inline>
    const scrollToLinkedKit = () => {
      if (!window.location.hash) return;
      const target = document.querySelector(window.location.hash);
      if (target) target.scrollIntoView({ block: "start" });
    };

    window.addEventListener("load", scrollToLinkedKit);
    window.addEventListener("hashchange", scrollToLinkedKit);

    document.querySelectorAll("[data-copy-prompt]").forEach((button) => {
      button.addEventListener("click", async () => {
        const panel = button.closest(".prompt-panel");
        const prompt = panel?.querySelector(".prompt-text");
        const status = panel?.querySelector(".copy-status");
        if (!prompt || !status) return;

        try {
          await navigator.clipboard.writeText(prompt.textContent?.trim() || "");
          status.textContent = "Copied";
          window.setTimeout(() => { status.textContent = ""; }, 1800);
        } catch {
          status.textContent = "Select the prompt and copy it manually.";
        }
      });
    });
  </script>
  <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
</BaseLayout>

<style>
  .download-hero{padding:82px 0 72px;color:var(--white);background:var(--ink)}
  .download-hero__inner{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.5fr);gap:72px;align-items:end}
  .download-hero__copy{max-width:900px}.download-hero h1{max-width:960px;margin-bottom:24px;font-size:clamp(3rem,5.5vw,5.2rem)}
  .download-hero__copy>p:last-child{max-width:720px;margin-bottom:0;color:#c6d5df;font-size:1.15rem}
  .download-hero .eyebrow,.support-band .eyebrow{color:var(--mint)}
  .hero-proof{display:grid;gap:0;border-top:1px solid rgba(255,255,255,.18)}
  .hero-proof span{display:flex;align-items:center;gap:9px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.18);font-weight:600}
  .hero-proof svg{color:var(--mint);flex:0 0 auto}

  .workspace-choice{padding:88px 0;background:#eaf1f3}.workspace-choice .compact-heading{max-width:820px}.workspace-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-block:1px solid #c5d3d9}.workspace-grid>div{min-width:0;padding:28px 24px}.workspace-grid>div:first-child{padding-left:0}.workspace-grid>div:last-child{padding-right:0}.workspace-grid>div+div{border-left:1px solid #c5d3d9}.workspace-label{display:block;margin-bottom:14px;color:var(--teal);font-size:.76rem;font-weight:800;text-transform:uppercase}.workspace-grid h3{margin-bottom:10px;font-size:1.3rem}.workspace-grid p{margin:0;color:var(--slate)}

  .access-section{padding:96px 0;color:var(--white);background:var(--blue);scroll-margin-top:84px}.access-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(440px,1.15fr);gap:82px;align-items:start}.access-copy{padding-top:28px}.access-copy .eyebrow{color:var(--mint)}.access-copy h2{max-width:620px;font-size:clamp(2.5rem,4.4vw,4rem)}.access-copy>p{max-width:620px;color:#c9d7e1;font-size:1.08rem}.access-copy ul{margin:30px 0 0;padding:0;list-style:none}.access-copy li{display:flex;align-items:center;gap:10px;padding:13px 0;border-top:1px solid rgba(255,255,255,.18);font-weight:700}.access-copy li:last-child{border-bottom:1px solid rgba(255,255,255,.18)}.access-copy li svg{flex:0 0 auto;color:var(--mint)}.access-form-wrap{position:relative;min-height:620px;padding:24px;border-radius:var(--radius);color:var(--ink);background:var(--white);box-shadow:0 20px 48px rgba(0,0,0,.2)}.form-loading{position:absolute;inset:24px;display:grid;place-content:center;justify-items:center;gap:14px;color:var(--slate);background:var(--white);transition:opacity .2s ease}.form-loading.is-hidden{pointer-events:none;opacity:0}.form-loading span{width:30px;height:30px;border:3px solid var(--line);border-top-color:var(--teal);border-radius:50%;animation:spin .8s linear infinite}.form-loading p{margin:0}.ghl-form{position:relative;z-index:1;display:block;width:100%;min-height:560px;border:0;border-radius:6px;background:transparent}.form-note{position:relative;z-index:2;margin:14px 8px 0;color:var(--slate);font-size:.78rem}.form-note a{color:var(--teal);font-weight:700}@keyframes spin{to{transform:rotate(360deg)}}

  .product-section{padding:100px 0;background:var(--mist);scroll-margin-top:76px}.product-section--alternate{background:var(--white)}
  .product-heading{display:grid;grid-template-columns:62px minmax(0,760px);gap:20px;align-items:start;margin-bottom:40px}.product-heading .eyebrow{margin:4px 0 12px}.product-heading h2{margin-bottom:16px;font-size:clamp(2.5rem,4.4vw,4rem)}.product-heading>div>p:last-child{margin:0;color:var(--slate);font-size:1.08rem}
  .product-icon{display:grid;width:62px;height:62px;place-items:center;border-radius:8px;color:var(--white);background:var(--blue)}
  .built-here{display:flex;align-items:flex-start;gap:12px;margin:-12px 0 32px 82px;padding:17px 20px;border-left:4px solid var(--mint);background:#e8f7f3}.built-here svg{flex:0 0 auto;color:var(--mint-dark)}.built-here p{margin:0}
  .download-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
  .download-option{display:flex;min-width:0;flex-direction:column;padding:32px;border:1px solid var(--line);border-radius:var(--radius);background:var(--white);box-shadow:0 14px 36px rgba(7,25,45,.08)}.product-section--alternate .download-option{background:var(--mist)}
  .download-option__top{display:flex;align-items:center;gap:14px;margin-bottom:20px}.platform-icon{display:grid;width:52px;height:52px;flex:0 0 52px;place-items:center;border-radius:6px;color:var(--white);background:var(--blue)}
  .file-type{margin:0 0 2px;color:var(--teal);font-size:.76rem;font-weight:700;text-transform:uppercase}.download-option h3{margin:0;font-size:1.8rem}.download-description{min-height:78px;color:var(--slate)}
  .install-steps{margin:8px 0 26px;padding:0;list-style:none;counter-reset:steps}.install-steps li{position:relative;min-height:46px;padding:10px 0 10px 38px;border-top:1px solid var(--line);counter-increment:steps}
  .install-steps li::before{content:counter(steps);position:absolute;left:0;top:10px;display:grid;width:24px;height:24px;place-items:center;border-radius:50%;color:var(--ink);background:var(--warm);font-size:.72rem;font-weight:800}
  .download-button{width:100%;margin-top:auto}.file-details{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-top:15px;color:var(--slate);font-size:.78rem}.file-details details{text-align:right}.file-details summary{cursor:pointer;font-weight:700}.file-details p{position:absolute;z-index:2;width:min(440px,calc(100vw - 40px));margin:8px 0 0;right:max(20px,calc((100vw - min(calc(100vw - 40px),1200px))/2));padding:12px;border:1px solid var(--line);border-radius:6px;text-align:left;background:var(--white);box-shadow:var(--shadow)}.file-details code{display:block;overflow-wrap:anywhere;margin-top:4px;color:var(--ink);font-size:.72rem}
  .prompt-row{display:grid;grid-template-columns:.55fr 1.45fr;gap:48px;align-items:center;margin-top:32px;padding-top:32px;border-top:1px solid var(--line)}.prompt-row .eyebrow{margin-bottom:10px}.prompt-row h3{margin:0;font-size:1.55rem}
  .prompt-panel{padding:24px;border-left:5px solid var(--warm);background:var(--ink)}.prompt-panel>p{margin-bottom:20px;color:var(--white);font-size:1rem}.copy-button{display:inline-flex;min-height:44px;align-items:center;gap:8px;padding:0 15px;border:1px solid var(--mint);border-radius:6px;color:var(--ink);background:var(--mint);font-weight:700;cursor:pointer}.copy-button:hover{background:#36c8ac}.copy-status{margin-left:10px;color:#c6d5df;font-size:.82rem}

  .compact-heading{margin-bottom:38px}.compact-heading h2{font-size:clamp(2.3rem,4vw,3.6rem)}
