---
import { CalendarCheck, Check, GraduationCap, MessageSquareText, Plug, Presentation, Workflow } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import CtaBand from "@components/CtaBand.astro";

const current = [
  [Workflow, "GoHighLevel fulfillment", "Native", "Appointments, communications, invoices, course activity, and other client-fulfillment records from the merchant's own sub-account."],
  [Presentation, "Zoom", "Connected", "Meeting and webinar attendance, join and leave times, and duration from the merchant's own Zoom account."],
  [Plug, "Custom software", "Available", "An authenticated Evidence API for software that can send client activity using a ScaleSafe enrollment reference."],
];

const roadmap = [
  [GraduationCap, "Courses and communities", "Kajabi, Teachable, Thinkific, Circle, Mighty Networks, LearnWorlds, LearnDash, MemberPress, and other course platforms."],
  [CalendarCheck, "Meetings and scheduling", "Google Meet, Calendly, and other sources that can help confirm scheduled and attended client sessions."],
  [Workflow, "Agency delivery", "ClickUp, Asana, monday.com, Teamwork, client portals, approvals, tasks, deliverables, and project activity."],
  [MessageSquareText, "Support and files", "Merchant-selected support conversations, client-facing files, acknowledgements, and delivery records."],
];
---

<BaseLayout title="Integrations" description="Connect GoHighLevel, Zoom, custom software, and future course, community, agency, meeting, support, and delivery platforms to ScaleSafe evidence.">
  <PageHero
    eyebrow="Evidence connections"
    title="Bring proof of delivery into the client record."
    lead="ScaleSafe connects the systems you use to communicate and fulfill, then keeps useful activity with the client program it belongs to."
    image="/images/product/evidence-connections-live.png"
    alt="ScaleSafe evidence connections showing GoHighLevel fulfillment and Zoom connected"
    caption="GoHighLevel fulfillment and a merchant-owned Zoom account connected in ScaleSafe."
  />

  <section class="current-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Working foundation</p><h2>Start with the tools already closest to the client.</h2><p>GoHighLevel is the native operating environment. Zoom and custom software can add delivery activity that would otherwise live outside the client record.</p></div><div class="current-grid">{current.map(([Icon,title,status,body])=><article><Icon size={24}/><div><div class="current-head"><h3>{title}</h3><span>{status}</span></div><p>{body}</p></div></article>)}</div></div></section>

  <section class="matching-section"><div class="shell matching-grid"><div><p class="eyebrow">Automatic matching</p><h2>Connect once and keep the record moving.</h2></div><div><p>ScaleSafe uses the merchant account, client identity, program timing, and known resource or enrollment references to connect activity to the right program. Once connected, normal fulfillment activity continues to arrive automatically.</p><ul class="plain-list"><li><Check size={18}/>Evidence stays with one merchant sub-account</li><li><Check size={18}/>Repeated purchases remain separate programs</li><li><Check size={18}/>Matched activity joins the correct enrollment timeline</li></ul></div></div></section>

  <section class="roadmap-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Integration catalog</p><h2>Expanding around how coaches and agencies fulfill.</h2><p>The next integrations focus on the places where merchants teach, meet, manage projects, share deliverables, and support clients.</p></div><div class="roadmap-grid">{roadmap.map(([Icon,title,body])=><article><Icon size={24}/><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>

  <section class="setup-section"><div class="shell setup-grid"><div><p class="eyebrow">Merchant setup</p><h2>Connect once, then let the records flow.</h2></div><ol><li><span>1</span><div><h3>Choose the platform</h3><p>Open Evidence Connections inside the merchant's ScaleSafe account.</p></div></li><li><span>2</span><div><h3>Authorize the merchant account</h3><p>Sign in through the provider or follow a short API-key or webhook setup.</p></div></li><li><span>3</span><div><h3>Confirm the offers</h3><p>Review suggested matches between the provider's courses, projects, or services and ScaleSafe offers.</p></div></li><li><span>4</span><div><h3>Activate and monitor</h3><p>Run a test, then use connection health to confirm evidence continues to arrive.</p></div></li></ol></div></section>
  <CtaBand title="Connect fulfillment to the client story." body="Tell us which systems you use. Private-beta setup focuses on the smallest useful connection for your business." />
</BaseLayout>

<style>
  .current-section,.matching-section,.roadmap-section,.setup-section{padding:110px 0}.current-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.current-grid article{display:grid;grid-template-columns:34px 1fr;gap:14px;min-height:270px;padding:30px 28px;border-right:1px solid var(--line)}.current-grid article:last-child{border-right:0}.current-grid>article>svg{margin-top:4px;color:var(--teal)}.current-grid p{color:var(--slate)}.current-head{display:flex;align-items:center;gap:10px}.current-head h3{margin-bottom:8px}.current-head span{padding:3px 8px;border-radius:4px;color:var(--teal);background:#e0f4ef;font-size:.7rem;font-weight:700;text-transform:uppercase}
  .matching-section{background:var(--mist)}.matching-grid,.setup-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:86px}.matching-grid h2,.setup-grid h2{margin:0}.matching-grid>div:last-child>p{color:var(--slate);font-size:1.08rem}
  .roadmap-section{color:var(--white);background:var(--ink)}.roadmap-section .section-heading p:last-child{color:var(--slate-light)}.roadmap-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.15)}.roadmap-grid article{min-height:290px;padding:30px 25px;border-right:1px solid rgba(255,255,255,.15)}.roadmap-grid article:last-child{border-right:0}.roadmap-grid svg{margin-bottom:44px;color:var(--mint)}.roadmap-grid p{color:var(--slate-light)}
  .setup-grid ol{margin:0;padding:0;list-style:none}.setup-grid li{display:grid;grid-template-columns:36px 1fr;gap:16px;padding:18px 0;border-top:1px solid var(--line)}.setup-grid li>span{display:grid;width:30px;height:30px;place-items:center;border:1px solid var(--teal);border-radius:50%;color:var(--teal);font-weight:700}.setup-grid h3,.setup-grid p{margin-bottom:4px}.setup-grid p{color:var(--slate)}
  @media(max-width:900px){.current-grid{grid-template-columns:1fr}.current-grid article{min-height:0;border-right:0;border-bottom:1px solid var(--line)}.matching-grid,.setup-grid{grid-template-columns:1fr;gap:46px}.roadmap-grid{grid-template-columns:1fr 1fr}.roadmap-grid article:nth-child(2){border-right:0}.roadmap-grid article{border-bottom:1px solid rgba(255,255,255,.15)}}
  @media(max-width:560px){.current-section,.matching-section,.roadmap-section,.setup-section{padding:82px 0}.roadmap-grid{grid-template-columns:1fr}.roadmap-grid article,.roadmap-grid article:nth-child(2){min-height:0;border-right:0}.roadmap-grid svg{margin-bottom:25px}}
</style>
