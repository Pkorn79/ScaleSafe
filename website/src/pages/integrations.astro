---
import { Check, CircleDashed, CloudCog, KeyRound, LockKeyhole, Route } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import CtaBand from "@components/CtaBand.astro";

const catalog = [
  { name: "GoHighLevel", status: "Native", capability: "Contacts, workflows, appointments, communications, course and fulfillment events supported by the installed app." },
  { name: "Zoom", status: "Beta", capability: "Merchant-owned OAuth connection and webhook event pipeline. Public attendance claims wait for final participant-event certification." },
  { name: "Custom Software Evidence API", status: "Available", capability: "Tenant-bound canonical API for service access, usage, sessions, progress, deliverables, support, and approved custom activity." },
  { name: "Stripe", status: "Available", capability: "Payment, recurring, refund, dispute, and supported evidence-submission records." },
  { name: "NMI", status: "Available", capability: "Payment, vault, recurring, refund, lifecycle, and reconciliation records." },
  { name: "Whop", status: "Beta", capability: "Hosted checkout, payments, memberships, refunds, and supported membership lifecycle actions." },
  { name: "Course and community platforms", status: "Staged", capability: "Kajabi, Teachable, Thinkific, Circle, and related providers are released only after provider-specific certification." },
  { name: "Agency fulfillment platforms", status: "Staged", capability: "ClickUp and later project, portal, file, and support systems will focus on delivery evidence rather than raw data dumps." },
];
---

<BaseLayout title="Integrations" description="Connect GoHighLevel, Zoom, custom software, payment channels, and staged fulfillment platforms to exact ScaleSafe enrollments.">
  <PageHero eyebrow="Integrations" title="Collect useful evidence without mixing clients or programs." lead="Each connection belongs to one merchant sub-account. Events become evidence only after ScaleSafe can match them to the exact client enrollment with defensible confidence." image="/images/product/evidence-connections.png" alt="ScaleSafe evidence connections catalog" />

  <section class="principles-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Connection principles</p><h2>Automatic after setup. Strict when matching.</h2><p>Merchants connect their own platform once. ScaleSafe discovers the relevant resources, suggests offer matches, and keeps collecting without asking the merchant to repair individual events.</p></div><div class="principle-grid"><article><KeyRound size={25}/><h3>Merchant-owned authorization</h3><p>OAuth or API credentials are stored per GHL location in the database. No per-merchant Railway variable is used.</p></article><article><Route size={25}/><h3>Exact enrollment binding</h3><p>Stable enrollment references and external IDs survive email changes and repeat purchases of the same offer.</p></article><article><LockKeyhole size={25}/><h3>Tenant isolation</h3><p>The credential determines the location. A webhook payload cannot select another merchant sub-account.</p></article><article><CircleDashed size={25}/><h3>Quarantine, not guessing</h3><p>Ambiguous events remain internal and never become evidence, alter access, or enter a defense packet.</p></article></div></div></section>

  <section class="catalog-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Current catalog</p><h2>Available, beta, and staged are different states.</h2><p>The website and merchant catalog must label each provider accurately instead of marketing a roadmap as a live integration.</p></div><div class="catalog-list">{catalog.map(item=><article><div><CloudCog size={22}/><h3>{item.name}</h3></div><p>{item.capability}</p><span>{item.status}</span></article>)}</div></div></section>

  <section class="defense-contract"><div class="shell contract-grid"><div><p class="eyebrow">Defense evidence contract</p><h2>Outside systems report facts. ScaleSafe decides how to present them.</h2></div><div><p>Providers can send timestamps, activity, actors, resources, duration, progress, and source identifiers. They cannot assign their own proof strength, reason-code tags, exhibit title, or defense conclusion.</p><ul><li><Check size={18}/> Source event time and ScaleSafe receipt time remain distinct</li><li><Check size={18}/> Authentication and matching method are retained</li><li><Check size={18}/> Raw JSON and mapper diagnostics stay out of packets</li><li><Check size={18}/> Attachments remain private until validated</li></ul></div></div></section>
  <CtaBand title="Bring fulfillment evidence into the right client record." />
</BaseLayout>

<style>
  .principles-section,.catalog-section,.defense-contract{padding:110px 0}.principle-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.principle-grid article{min-height:300px;padding:30px 25px;border-right:1px solid var(--line)}.principle-grid article:last-child{border-right:0}.principle-grid svg{margin-bottom:46px;color:var(--teal)}.principle-grid p,.catalog-list p,.contract-grid p{color:var(--slate)}.catalog-section{background:var(--mist)}.catalog-list{border-top:1px solid var(--line)}.catalog-list article{display:grid;grid-template-columns:.72fr 1.8fr auto;gap:28px;align-items:center;padding:22px 0;border-bottom:1px solid var(--line)}.catalog-list article>div{display:flex;align-items:center;gap:12px}.catalog-list h3,.catalog-list p{margin:0}.catalog-list svg{color:var(--teal);flex:0 0 auto}.catalog-list span{min-width:78px;padding:5px 9px;border-radius:4px;color:var(--teal);background:#e0f4ef;font-size:.72rem;font-weight:700;text-align:center;text-transform:uppercase;letter-spacing:0}.defense-contract{color:var(--white);background:var(--ink)}.contract-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px}.contract-grid h2{margin:0}.contract-grid p{color:var(--slate-light);font-size:1.08rem}.contract-grid ul{margin:26px 0 0;padding:0;list-style:none}.contract-grid li{display:flex;gap:9px;padding:10px 0;border-top:1px solid rgba(255,255,255,.15)}.contract-grid li svg{color:var(--mint);flex:0 0 auto}@media(max-width:900px){.principle-grid{grid-template-columns:1fr 1fr}.principle-grid article:nth-child(2){border-right:0}.contract-grid{grid-template-columns:1fr;gap:42px}.catalog-list article{grid-template-columns:1fr auto}.catalog-list article>p{grid-column:1/-1;grid-row:2}}@media(max-width:560px){.principles-section,.catalog-section,.defense-contract{padding:82px 0}.principle-grid{grid-template-columns:1fr}.principle-grid article,.principle-grid article:nth-child(2){min-height:0;border-right:0;border-bottom:1px solid var(--line)}.principle-grid svg{margin-bottom:26px}.catalog-list article{gap:12px}.catalog-list span{min-width:70px}}
</style>
