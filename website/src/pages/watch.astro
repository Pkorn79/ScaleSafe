---
import { ArrowDown, CalendarDays, Check } from "@lucide/astro";
import VideoPlayer from "@components/VideoPlayer.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { explainerVideo, walkthroughVideo } from "../data/videoAssets";
---

<BaseLayout
  title="Watch ScaleSafe"
  description="See how ScaleSafe organizes enrollment, consent, payment, fulfillment, client engagement, and chargeback evidence in one client record."
  image={explainerVideo.poster}
>
  <section class="watch-hero">
    <div class="shell watch-shell">
      <div class="watch-heading">
        <p class="eyebrow">ScaleSafe in 77 seconds</p>
        <h1>Chargebacks answered from proof you already have.</h1>
        <p>Most high-ticket businesses rebuild their evidence after a dispute lands. ScaleSafe collects it while you deliver, flags client concerns earlier, and keeps each program's records together.</p>
      </div>
      <VideoPlayer {...explainerVideo} />
      <a class="button watch-next" href="#walkthrough">See exactly how it works <ArrowDown size={18} /></a>
    </div>
  </section>

  <section class="walkthrough-section" id="walkthrough">
    <div class="shell watch-shell">
      <div class="watch-heading">
        <p class="eyebrow">The full walkthrough</p>
        <h2>From enrollment to defense packet in two minutes.</h2>
      </div>
      <VideoPlayer {...walkthroughVideo} />
      <div class="walkthrough-summary">
        <p>ScaleSafe handles offer setup, enrollment with consent capture, dual-pricing checkout, one clean client record, automatic evidence collection, and the defense packet when a dispute arrives.</p>
        <ul>
          <li><Check size={18} /> Runs inside GoHighLevel</li>
          <li><Check size={18} /> Works with the processor you already use</li>
          <li><Check size={18} /> Keeps evidence with the correct client program</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="booking-section" id="book">
    <div class="shell booking-grid">
      <div class="booking-copy">
        <p class="eyebrow">Get it set up on your account</p>
        <h2>Book a short setup call.</h2>
        <p>We will confirm how you sell, fulfill, and get paid, then map the cleanest ScaleSafe setup for your business.</p>
        <p class="booking-note"><CalendarDays size={19} /> 15-minute introductory call</p>
      </div>
      <div class="calendar-wrap">
        <div class="calendar-loading" aria-hidden="true"><span></span><p>Loading the calendar...</p></div>
        <iframe
          src="https://api.leadconnectorhq.com/widget/booking/JiENAfmfiLahKveHqILn"
          id="inline-JiENAfmfiLahKveHqILn"
          class="ghl-calendar"
          title="Book a ScaleSafe introductory call"
          onload="this.previousElementSibling?.classList.add('is-hidden')"
        ></iframe>
      </div>
    </div>
  </section>

  <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
</BaseLayout>

<style>
  .watch-hero,
  .walkthrough-section,
  .booking-section {
    padding: 104px 0;
  }

  .watch-hero {
    padding-top: 92px;
    background: linear-gradient(180deg, #f4fbf9 0%, #fff 72%);
  }

  .watch-shell {
    max-width: 980px;
  }

  .watch-heading {
    max-width: 800px;
    margin: 0 auto 34px;
    text-align: center;
  }

  .watch-heading h1,
  .watch-heading h2 {
    margin-bottom: 20px;
  }

  .watch-heading > p:not(.eyebrow) {
    color: var(--slate);
    font-size: 1.12rem;
  }

  .watch-next {
    width: fit-content;
    margin: 30px auto 0;
  }

  .walkthrough-section {
    background: var(--mist);
  }

  .walkthrough-summary {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 50px;
    align-items: start;
    margin-top: 34px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
  }

  .walkthrough-summary > p {
    margin: 0;
    color: var(--slate);
    font-size: 1.06rem;
  }

  .walkthrough-summary ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .walkthrough-summary li {
    display: flex;
    gap: 9px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-weight: 600;
  }

  .walkthrough-summary li:first-child {
    border-top: 0;
  }

  .walkthrough-summary svg {
    flex: 0 0 auto;
    color: var(--mint-dark);
  }

  .booking-section {
    background: var(--white);
  }

  .booking-grid {
    display: grid;
    grid-template-columns: .72fr 1.28fr;
    gap: 70px;
    align-items: start;
  }

  .booking-copy {
    position: sticky;
    top: 110px;
  }

  .booking-copy > p:not(.eyebrow, .booking-note) {
    color: var(--slate);
    font-size: 1.08rem;
  }

  .booking-note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 26px;
    font-weight: 700;
  }

  .booking-note svg {
    color: var(--teal);
  }

  .calendar-wrap {
    position: relative;
    min-height: 820px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .calendar-loading {
    position: absolute;
    inset: 18px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    color: var(--slate);
    background: var(--white);
    transition: opacity .2s ease;
  }

  .calendar-loading.is-hidden {
    pointer-events: none;
    opacity: 0;
  }

  .calendar-loading span {
    width: 30px;
    height: 30px;
    border: 3px solid var(--line);
    border-top-color: var(--teal);
    border-radius: 50%;
    animation: spin .8s linear infinite;
  }

  .calendar-loading p {
    margin: 0;
  }

  .ghl-calendar {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    min-height: 780px;
    border: 0;
    background: transparent;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 820px) {
    .watch-hero,
    .walkthrough-section,
    .booking-section {
      padding: 82px 0;
    }

    .booking-grid,
    .walkthrough-summary {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .booking-copy {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .watch-hero {
      padding-top: 64px;
    }

    .watch-next {
      width: 100%;
    }

    .calendar-wrap {
      min-height: 900px;
      padding: 8px;
    }

    .calendar-loading {
      inset: 8px;
    }

    .ghl-calendar {
      min-height: 880px;
    }
  }
</style>
