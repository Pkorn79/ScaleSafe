---
import { Check } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";

const shared = ["Enrollment-scoped evidence timeline", "Offers, consent, milestones, and pulse", "Payment and lifecycle records", "Reason-code-aware defense packet for review", "GoHighLevel workflow triggers", "Merchant onboarding and provisioning support"];
---

<BaseLayout title="Pricing" description="ScaleSafe private beta pricing for merchants using NMI or Stripe, with scoped implementation support for processors and fulfillment integrations.">
  <PageHero compact eyebrow="Private beta pricing" title="Choose the plan that matches your processing rail." lead="Both plans include the ScaleSafe client-evidence lifecycle. Setup is scoped when your payment, fulfillment, or external systems need hands-on implementation." image="/images/product/dashboard-active.png" alt="ScaleSafe merchant dashboard" />
  <section class="plans-section"><div class="shell plans-grid"><article><div class="plan-head"><p>NMI plan</p><p class="price"><strong>$59</strong><span>/month</span></p><p>For merchants using a Whole Pay or other supported NMI setup.</p></div><ul>{shared.map(item=><li><Check size={18}/>{item}</li>)}<li><Check size={18}/>NMI checkout, vault, recurring, refund, and reconciliation records</li></ul><a class="button" href="/beta">Request NMI beta access</a></article><article class="featured"><div class="plan-head"><p>Stripe plan</p><p class="price"><strong>$99</strong><span>/month</span></p><p>For merchants keeping Stripe while adding ScaleSafe evidence and defense workflows.</p></div><ul>{shared.map(item=><li><Check size={18}/>{item}</li>)}<li><Check size={18}/>Supported Stripe evidence submission, Risk Health, and alert guidance</li></ul><a class="button" href="/beta">Request Stripe beta access</a></article></div><p class="pricing-disclosure shell">Pricing and availability are confirmed during private-beta onboarding. Marketplace billing is not active for beta. Payment-channel capabilities differ and are documented before setup.</p></section>
  <section class="setup-section"><div class="shell setup-grid"><div><p class="eyebrow">Custom setup</p><h2>Implementation support, priced by scope.</h2></div><div><p>Some merchants need only processor connection and one certified offer. Others need fulfillment platforms, custom software, course access, workflow cleanup, or processor configuration connected. ScaleSafe scopes that work with the merchant rather than hiding it inside an arbitrary fee.</p><h3>Setup may include</h3><ul><li>Merchant settings, branding, subdomain, sender details, and support contact</li><li>Processor connection and test checkout certification</li><li>Snapshot, workflow, and provisioning-health verification</li><li>Offer and enrollment-flow setup</li><li>Fulfillment and evidence connection mapping</li><li>Operator training and launch proof</li></ul></div></div></section>
  <section class="beta-cta"><div class="shell"><h2>Tell us how you sell and get paid.</h2><p>We will confirm fit, beta availability, and the smallest useful setup for your business.</p><a class="button" href="/beta">Request private beta access</a></div></section>
</BaseLayout>

<style>
  .plans-section,.setup-section,.beta-cta{padding:110px 0}.plans-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.plans-grid article{padding:42px;border:1px solid var(--line);border-radius:var(--radius);background:var(--mist)}.plans-grid article.featured{color:var(--white);background:var(--blue);border-color:var(--blue)}.plan-head>p:first-child{font-weight:700}.price{display:flex;align-items:baseline;gap:7px;margin:18px 0}.price strong{font-family:var(--font-display);font-size:4.2rem;line-height:1}.price span{color:var(--slate)}.featured .price span,.featured .plan-head>p:last-child{color:#c4d2db}.plans-grid ul{margin:30px 0;padding:0;list-style:none}.plans-grid li{display:flex;gap:9px;padding:11px 0;border-top:1px solid var(--line)}.featured li{border-color:rgba(255,255,255,.15)}.plans-grid li svg{color:var(--mint-dark);flex:0 0 auto}.featured li svg{color:var(--mint)}.pricing-disclosure{margin-top:20px;color:var(--slate);font-size:.88rem}.setup-section{background:var(--white)}.setup-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px}.setup-grid h2{margin:0}.setup-grid>div:last-child>p,.setup-grid li{color:var(--slate)}.setup-grid h3{margin-top:34px}.beta-cta{text-align:center;color:var(--white);background:var(--ink)}.beta-cta h2{max-width:800px;margin-inline:auto}.beta-cta p{max-width:620px;margin:0 auto 28px;color:var(--slate-light);font-size:1.08rem}@media(max-width:800px){.plans-grid,.setup-grid{grid-template-columns:1fr;gap:42px}}@media(max-width:560px){.plans-section,.setup-section,.beta-cta{padding:82px 0}.plans-grid article{padding:28px 22px}}
</style>

