---
import { Check, KeyRound, ShieldCheck } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";

const shared = ["Offers, enrollment, consent, milestones, and pulse", "Program-level payment and evidence history", "Dashboard attention and dispute tracking", "Reason-code-aware defense packet for merchant review", "GoHighLevel workflows and merchant provisioning"];
---

<BaseLayout title="Pricing" description="ScaleSafe Standard is $99 per month. WholePay Approved pricing is $59 per month for merchants approved for a WholePay merchant account.">
  <PageHero compact eyebrow="Private beta pricing" title="One product. Two ways to qualify." lead="Standard is available to approved ScaleSafe merchants. WholePay Approved pricing is reserved for merchants approved for a merchant processing account through WholePay." />

  <section class="plans-section"><div class="shell plans-grid">
    <article class="featured"><div class="plan-head"><p>Standard</p><p class="price"><strong>$99</strong><span>/month</span></p><p>For approved merchants using their existing supported payment setup.</p></div><ul>{shared.map(item=><li><Check size={18}/>{item}</li>)}<li><Check size={18}/>Supported connected payment channels</li></ul><a class="button" href="/beta">Request Standard beta access</a></article>
    <article><div class="plan-head"><p>WholePay Approved</p><p class="price"><strong>$59</strong><span>/month</span></p><p>For merchants approved for a merchant processing account through WholePay.</p></div><ul>{shared.map(item=><li><Check size={18}/>{item}</li>)}<li><Check size={18}/>WholePay merchant processing</li></ul><a class="button" href="/beta">Ask about WholePay approval</a></article>
  </div><div class="shell eligibility-note"><KeyRound size={24}/><div><h2>WholePay Approved pricing is tied to a WholePay merchant account.</h2><p>WholePay confirms merchant-account approval and provisions the $59 plan.</p></div></div></section>

  <section class="billing-section"><div class="shell billing-grid"><div><p class="eyebrow">Marketplace billing</p><h2>Your plan follows your approved payment setup.</h2></div><div><p>Standard is the regular ScaleSafe subscription. WholePay Approved is the preferred rate for merchants who establish their merchant processing account through WholePay.</p><ul class="plain-list"><li><ShieldCheck size={18}/>The complete ScaleSafe evidence product on both plans</li><li><ShieldCheck size={18}/>Payment channels matched to the merchant's setup</li><li><ShieldCheck size={18}/>Plan activation confirmed during onboarding</li></ul></div></div></section>

  <section class="setup-section"><div class="shell setup-grid"><div><p class="eyebrow">Custom setup</p><h2>Hands-on implementation is scoped separately.</h2></div><div><p>Some businesses need only a connected processor and one configured offer. Others need subdomain setup, branding, workflow cleanup, fulfillment platforms, custom software, or processor configuration. We quote that work according to the actual setup required.</p><h3>Setup can include</h3><ul><li>Merchant settings, logo, subdomain, sending details, and support contact</li><li>Processor connection and checkout testing</li><li>Snapshot, workflow, and setup verification</li><li>Offer and enrollment-flow setup</li><li>Fulfillment and evidence connections</li><li>Operator training and launch review</li></ul></div></div></section>

  <section class="beta-cta"><div class="shell"><h2>Tell us how you sell and get paid.</h2><p>We will confirm fit, plan eligibility, and the smallest useful setup for your business.</p><a class="button" href="/beta">Request private beta access</a></div></section>
</BaseLayout>

<style>
  .plans-section,.billing-section,.setup-section,.beta-cta{padding:110px 0}.plans-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.plans-grid article{display:flex;flex-direction:column;padding:42px;border:1px solid var(--line);border-radius:var(--radius);background:var(--mist)}.plans-grid article.featured{color:var(--white);background:var(--blue);border-color:var(--blue)}.plan-head>p:first-child{font-weight:700}.price{display:flex;align-items:baseline;gap:7px;margin:18px 0}.price strong{font-family:var(--font-display);font-size:4.2rem;line-height:1}.price span{color:var(--slate)}.featured .price span,.featured .plan-head>p:last-child{color:#c4d2db}.plans-grid ul{margin:30px 0;padding:0;list-style:none}.plans-grid li{display:flex;gap:9px;padding:11px 0;border-top:1px solid var(--line)}.featured li{border-color:rgba(255,255,255,.15)}.plans-grid li svg{color:var(--mint-dark);flex:0 0 auto}.featured li svg{color:var(--mint)}.plans-grid .button{align-self:flex-start;margin-top:auto}.eligibility-note{display:grid;grid-template-columns:48px 1fr;gap:18px;margin-top:34px;padding:28px;border:1px solid #efd8ad;border-radius:var(--radius);background:#fff8ec}.eligibility-note svg{margin-top:7px;color:#9b6422}.eligibility-note h2{font-size:1.5rem}.eligibility-note p{margin:0;color:var(--slate)}
  .billing-section{background:var(--mist)}.billing-grid,.setup-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px}.billing-grid h2,.setup-grid h2{margin:0}.billing-grid>div:last-child>p,.setup-grid>div:last-child>p,.setup-grid li{color:var(--slate);font-size:1.06rem}.setup-grid h3{margin-top:34px}.beta-cta{text-align:center;color:var(--white);background:var(--ink)}.beta-cta h2{max-width:800px;margin-inline:auto}.beta-cta p{max-width:620px;margin:0 auto 28px;color:var(--slate-light);font-size:1.08rem}
  @media(max-width:800px){.plans-grid,.billing-grid,.setup-grid{grid-template-columns:1fr;gap:42px}}
  @media(max-width:560px){.plans-section,.billing-section,.setup-section,.beta-cta{padding:82px 0}.plans-grid article{padding:28px 22px}.eligibility-note{grid-template-columns:36px 1fr}}
</style>
