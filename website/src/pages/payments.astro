---
import { Banknote, Check, CreditCard, RefreshCcw, ShieldCheck, WalletCards } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import CtaBand from "@components/CtaBand.astro";

const structures = [
  [CreditCard, "Paid in full", "Collect the full amount at enrollment and keep the payment with the signed program record."],
  [WalletCards, "Installments", "Set the number, amount, and frequency of payments while tracking progress against the program."],
  [RefreshCcw, "Subscriptions", "Manage ongoing billing with the lifecycle controls available through the connected provider."],
  [Banknote, "Card and bank", "Offer card and ACH where supported, including dual-pricing flows that show the selected amount before payment."],
];

const channels = [
  ["Stripe", "Card and ACH checkout", "Paid in full, installments, subscriptions, refunds, saved methods, Risk Health, and supported dispute evidence submission."],
  ["WholePay", "Merchant-account processing", "Card and bank checkout, saved methods, recurring billing, refunds, and payment reconciliation."],
  ["Whop", "Hosted checkout", "Paid-in-full and recurring checkout, recorded add-ons, refunds, and membership pause, resume, and cancellation."],
];
---

<BaseLayout title="Payments" description="ScaleSafe supports paid-in-full, installment, subscription, card, bank, Stripe, WholePay, and Whop payment records tied to the correct client program.">
  <PageHero
    eyebrow="Payments"
    title="Get paid in the way the offer is actually sold."
    lead="ScaleSafe supports paid-in-full, installment, and subscription offers while keeping payment history, refunds, and account changes with the client program."
    image="/images/product/client-programs-high-ticket.png"
    alt="ScaleSafe client programs showing high-ticket payments and payment progress"
    caption="The merchant can see the amount paid, payment method, next billing date, and program status together."
  />

  <section class="structure-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Offer structure</p><h2>Match the payment plan to the offer.</h2><p>Use the billing model that fits the way the program is sold and delivered.</p></div><div class="structure-grid">{structures.map(([Icon,title,body])=><article><Icon size={24}/><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>

  <section class="settlement-section"><div class="shell settlement-grid"><div><p class="eyebrow">Where the money goes</p><h2>Your connected provider settles the funds.</h2></div><div><p>ScaleSafe coordinates the checkout and records the payment against the client program. Stripe, WholePay merchant processing, or a hosted provider such as Whop handles payment and settlement through the merchant's connected account.</p><ul class="plain-list"><li><Check size={18}/>Processor transaction references stay with the payment</li><li><Check size={18}/>Refunds and account changes remain visible in the client history</li><li><Check size={18}/>Payment evidence is available when a dispute needs to be reviewed</li></ul></div></div></section>

  <section class="channel-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Connected payment channels</p><h2>Use one operating record across providers.</h2><p>ScaleSafe brings each provider's checkout, payment, refund, and account actions into the same client-program history.</p></div><div class="channel-list">{channels.map(([name,label,body])=><article><div><h3>{name}</h3><span>{label}</span></div><p>{body}</p></article>)}</div></div></section>

  <section class="choice-section"><div class="shell choice-grid"><div><p class="eyebrow">Card and bank choice</p><h2>Show the amount before the client pays.</h2><p>Where the offer and provider support it, ScaleSafe can present card and bank options with the correct due-today amount for each choice. Public checkout can also use Cloudflare Turnstile to reduce automated abuse.</p></div><div class="choice-points"><article><span>Card</span><h3>The card amount is visible.</h3><p>The client sees the amount due for the convenience of paying by card.</p></article><article><span>Bank</span><h3>The bank amount is visible.</h3><p>The total updates before submission when bank payment uses different pricing.</p></article><ul class="plain-list"><li><Check size={18}/>Paid-in-full or installment terms are shown before consent</li><li><Check size={18}/>Add-ons are recorded with the initial checkout</li><li><Check size={18}/>The selected method and total remain part of the payment record</li></ul></div></div></section>

  <section class="boundary-section"><div class="shell"><ShieldCheck size={28}/><div><h2>Payment details stay with the provider.</h2><p>Processor-hosted fields, tokens, vault references, and hosted checkout keep payment collection with the connected provider. ScaleSafe records the masked references needed for the client program.</p></div></div></section>
  <CtaBand title="Connect payment to the whole client record." />
</BaseLayout>

<style>
  .structure-section,.settlement-section,.channel-section,.choice-section,.boundary-section{padding:110px 0}.structure-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.structure-grid article{min-height:290px;padding:30px 25px;border-right:1px solid var(--line)}.structure-grid article:last-child{border-right:0}.structure-grid svg{margin-bottom:45px;color:var(--teal)}.structure-grid p{color:var(--slate)}
  .settlement-section{background:var(--mist)}.settlement-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:86px}.settlement-grid h2{margin:0}.settlement-grid>div:last-child>p{color:var(--slate);font-size:1.08rem}
  .channel-section{color:var(--white);background:var(--ink)}.channel-section .section-heading p:last-child{color:var(--slate-light)}.channel-list{border-top:1px solid rgba(255,255,255,.15)}.channel-list article{display:grid;grid-template-columns:.7fr 1.3fr;gap:44px;padding:27px 0;border-bottom:1px solid rgba(255,255,255,.15)}.channel-list h3{margin-bottom:5px}.channel-list span{color:var(--mint);font-size:.8rem;font-weight:700;text-transform:uppercase}.channel-list p{margin:0;color:var(--slate-light)}
  .choice-section{background:var(--white)}.choice-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:76px;align-items:start}.choice-grid>div>p:not(.eyebrow){color:var(--slate);font-size:1.08rem}.choice-points{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.choice-points article{padding:24px 24px 18px 0;border-right:1px solid var(--line)}.choice-points article+article{padding-left:24px;border-right:0}.choice-points span{color:var(--teal);font-size:.78rem;font-weight:700;text-transform:uppercase}.choice-points h3{margin-top:16px}.choice-points p{color:var(--slate)}.choice-points .plain-list{grid-column:1/-1}
  .boundary-section{padding:70px 0;background:var(--attention-bg)}.boundary-section>.shell{display:grid;grid-template-columns:50px 1fr;gap:18px;max-width:960px}.boundary-section svg{margin-top:7px;color:var(--attention)}.boundary-section h2{margin-bottom:12px}.boundary-section p{margin:0;color:var(--slate);font-size:1.08rem}
  @media(max-width:900px){.structure-grid{grid-template-columns:1fr 1fr}.structure-grid article:nth-child(2){border-right:0}.structure-grid article{border-bottom:1px solid var(--line)}.settlement-grid,.choice-grid{grid-template-columns:1fr;gap:46px}}
  @media(max-width:560px){.structure-section,.settlement-section,.channel-section,.choice-section{padding:82px 0}.structure-grid{grid-template-columns:1fr}.structure-grid article,.structure-grid article:nth-child(2){min-height:0;border-right:0}.structure-grid svg{margin-bottom:26px}.channel-list article{grid-template-columns:1fr;gap:12px}.choice-points{grid-template-columns:1fr}.choice-points article,.choice-points article+article{padding:22px 0;border-right:0;border-bottom:1px solid var(--line)}.boundary-section>.shell{grid-template-columns:38px 1fr}}
</style>
