---
import { Check, Minus } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import CtaBand from "@components/CtaBand.astro";

const rows = [
  ["Card checkout", true, true, "Hosted"],
  ["ACH / bank payment", true, true, "Provider checkout"],
  ["Paid in full and installments", true, true, true],
  ["Recurring progress", true, true, true],
  ["Refund from ScaleSafe", true, true, "When Whop payment ID exists"],
  ["Pause, resume, cancel", true, true, "When Whop membership ID exists"],
  ["Saved-method manual charge", true, true, false],
  ["ScaleSafe holds merchant funds", false, false, false],
];
---

<BaseLayout title="Payments" description="Understand ScaleSafe payment capabilities across Stripe, NMI, and Whop, including paid-in-full, installments, recurring records, refunds, ACH, and lifecycle actions.">
  <PageHero eyebrow="Payments" title="Payment records that stay attached to the program." lead="ScaleSafe supports the channels high-ticket businesses already use while keeping the charge, payment schedule, refund, cancellation, and enrollment evidence connected." image="/images/product/payments-reconciliation-summary.png" alt="ScaleSafe payment reconciliation view" />

  <section class="principle-section"><div class="shell principle-grid"><div><p class="eyebrow">Processor-direct settlement</p><h2>Your processor moves the money.</h2></div><div><p>ScaleSafe creates or coordinates the checkout, records what happened, and connects processor truth to the client program. Funds settle through the merchant's Stripe, NMI, or hosted checkout provider. ScaleSafe is not a merchant of record and does not hold the funds.</p></div></div></section>

  <section class="capability-section"><div class="shell"><div class="section-heading"><p class="eyebrow">Channel capabilities</p><h2>Similar records. Different processor controls.</h2><p>Each integration exposes different actions. The interface should only offer a refund, pause, resume, cancel, or saved-method charge when that provider and record actually support it.</p></div><div class="table-wrap"><table><thead><tr><th>Capability</th><th>Stripe</th><th>NMI</th><th>Whop</th></tr></thead><tbody>{rows.map((row) => <tr>{row.map((cell, index) => <td>{index === 0 ? cell : cell === true ? <><Check size={18} /><span class="sr-only">Supported</span></> : cell === false ? <><Minus size={18} /><span class="sr-only">Not supported</span></> : cell}</td>)}</tr>)}</tbody></table></div></div></section>

  <section class="pricing-tools"><div class="shell tools-grid"><div><p class="eyebrow">Checkout economics</p><h2>Offer bank payment without losing card choice.</h2><p>ScaleSafe supports ACH and dual-pricing flows where the connected processor and offer configuration allow them. The customer sees the due-today amount for the selected payment method before submitting.</p><ul><li><Check size={18} /> Card and bank amounts remain visible</li><li><Check size={18} /> Turnstile can protect public checkout actions</li><li><Check size={18} /> Money reaches processors as validated integer cents</li></ul></div><figure><div class="product-frame"><img src="/images/product/public-offer-review.png" alt="ScaleSafe offer payment choice" width="1920" height="968" loading="lazy" /></div><figcaption class="image-caption">The public offer summary makes payment structure and due-today amount explicit.</figcaption></figure></div></section>

  <section class="reconciliation-section"><div class="shell reconciliation-grid"><figure><div class="product-frame"><img src="/images/product/payments-reconciliation-summary.png" alt="ScaleSafe reconciliation controls" width="1920" height="968" loading="lazy" /></div><figcaption class="image-caption">Reconciliation flags missing IDs, mismatches, overdue billing, duplicates, and recent failures.</figcaption></figure><div><p class="eyebrow">Operational truth</p><h2>Compare ScaleSafe records with processor reality.</h2><p>Webhook delivery, processor identifiers, and recurring schedules can drift. Reconciliation gives the merchant and support team a focused way to find records that need attention without guessing from the client profile.</p></div></div></section>
  <CtaBand title="Connect payments to the evidence they create." />
</BaseLayout>

<style>
  .principle-section,.capability-section,.pricing-tools,.reconciliation-section{padding:110px 0}.principle-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px}.principle-grid h2{margin:0}.principle-grid>div:last-child p{color:var(--slate);font-size:1.12rem}.capability-section{background:var(--mist)}.table-wrap{width:100%;max-width:100%;min-width:0;overflow-x:auto;contain:inline-size;border:1px solid var(--line);border-radius:var(--radius);background:var(--white)}table{width:100%;min-width:760px;border-collapse:collapse}th,td{padding:18px 20px;border-bottom:1px solid var(--line);text-align:left}th{color:var(--white);background:var(--blue);font-size:.82rem;text-transform:uppercase;letter-spacing:0}td:first-child{font-weight:700}td svg{color:var(--mint-dark)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.tools-grid,.reconciliation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:76px;align-items:center}.tools-grid>div>p:not(.eyebrow),.reconciliation-grid>div>p:not(.eyebrow){color:var(--slate);font-size:1.08rem}.tools-grid ul{margin:26px 0 0;padding:0;list-style:none}.tools-grid li{display:flex;gap:9px;padding:9px 0;font-weight:600}.tools-grid li svg{color:var(--mint-dark)}figure{margin:0}.tools-grid .product-frame,.reconciliation-grid .product-frame{aspect-ratio:1.6}.reconciliation-section{color:var(--white);background:var(--ink)}.reconciliation-section .eyebrow{color:var(--mint)}.reconciliation-grid>div>p:not(.eyebrow),.reconciliation-section .image-caption{color:var(--slate-light)}@media(max-width:800px){.principle-grid,.tools-grid,.reconciliation-grid{grid-template-columns:1fr;gap:44px}.reconciliation-grid figure{order:2}}@media(max-width:680px){.table-wrap{overflow:hidden;contain:none}table{display:block;min-width:0}thead{display:none}tbody{display:block}tr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:16px 14px;border-bottom:1px solid var(--line)}tr:last-child{border-bottom:0}td{display:grid;min-width:0;place-items:start center;gap:5px;padding:7px 4px;border:0;text-align:center;font-size:.75rem;line-height:1.35;overflow-wrap:anywhere}td:first-child{grid-column:1/-1;display:block;margin-bottom:4px;padding:0 0 10px;border-bottom:1px solid var(--line);text-align:left;font-size:.9rem}td:nth-child(2)::before{content:"Stripe"}td:nth-child(3)::before{content:"NMI"}td:nth-child(4)::before{content:"Whop"}td:not(:first-child)::before{color:var(--slate);font-size:.66rem;font-weight:700;text-transform:uppercase}}@media(max-width:560px){.principle-section,.capability-section,.pricing-tools,.reconciliation-section{padding:82px 0}}
</style>
