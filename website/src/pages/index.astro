---
import {
  ArrowRight,
  BellRing,
  CalendarCheck,
  Check,
  ClipboardCheck,
  CreditCard,
  FileText,
  MessageSquareText,
  Plug,
  ShieldCheck,
  WalletCards,
} from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const record = [
  [ClipboardCheck, "What they agreed to", "The offer, payment choice, responsibilities, refund terms, clickwrap acceptance, and signature."],
  [CreditCard, "What they paid", "Paid-in-full, installment, subscription, refund, and cancellation records connected to the program."],
  [CalendarCheck, "What you delivered", "Milestones, appointments, attendance, access, resources, course activity, and other fulfillment records."],
  [MessageSquareText, "What happened next", "Messages, pulse responses, client concerns, follow-up, and the ongoing history of the relationship."],
];

const lifecycle = [
  ["01", "Set the agreement", "Build the offer, payment plan, client responsibilities, delivery schedule, and terms before the client enrolls."],
  ["02", "Capture the journey", "Keep payment, communication, progress, and delivery records with the program they belong to."],
  ["03", "Act on concerns", "See pulse responses, failed payments, open disputes, and other items that need attention."],
  ["04", "Prepare the response", "If a chargeback happens, organize the relevant evidence around the transaction and dispute reason."],
];

const paymentChannels = [
  ["Stripe", "Card and ACH checkout, payment plans, subscriptions, refunds, Risk Health, and supported dispute evidence submission."],
  ["NMI", "Card and bank checkout, saved payment methods, recurring billing, refunds, and WholePay merchant processing."],
  ["Whop", "Hosted checkout, recurring membership payments, refunds, and membership pause, resume, and cancellation."],
];
---

<BaseLayout
  title="ScaleSafe"
  description="ScaleSafe helps high-ticket coaches, agencies, course sellers, and service businesses collect proof of agreement, payment, delivery, and client engagement before a chargeback happens."
  image="/images/product/dashboard-operations.png"
>
  <section class="home-hero">
    <div class="shell home-hero__copy">
      <p class="eyebrow">Chargeback readiness for high-ticket client businesses</p>
      <h1>ScaleSafe</h1>
      <p class="hero-promise">Build the proof while you deliver.</p>
      <p class="hero-lead">ScaleSafe keeps the agreement, payment, progress, messages, and delivery records for each client program in one place. If a chargeback happens, the evidence is already organized around the right transaction.</p>
      <div class="hero-actions">
        <a class="button" href="/beta">Request private beta access <ArrowRight size={18} /></a>
        <a class="text-action" href="#how-it-works">See how it works</a>
      </div>
      <ul class="hero-facts" aria-label="ScaleSafe product facts">
        <li><Check size={17} /> Runs inside GoHighLevel</li>
        <li><Check size={17} /> Works with Stripe, NMI, and Whop</li>
        <li><Check size={17} /> You review every defense before submission</li>
      </ul>
    </div>
    <figure class="shell hero-product">
      <div class="product-frame">
        <img src="/images/product/dashboard-operations.png" alt="Active ScaleSafe dashboard showing open disputes and a client pulse response that needs attention" width="1908" height="1008" />
      </div>
      <figcaption class="image-caption">An active ScaleSafe test installation: open disputes, evidence volume, and a client follow-up request are visible from the dashboard.</figcaption>
    </figure>
  </section>

  <section class="record-section" id="how-it-works">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">The complete client record</p>
        <h2>A receipt is not the whole story.</h2>
        <p>Most service disputes are decided by what can be shown clearly. ScaleSafe collects the parts of the relationship that are usually scattered across checkout pages, inboxes, calendars, course platforms, and project tools.</p>
      </div>
      <div class="record-grid">
        {record.map(([Icon, title, body]) => (
          <article>
            <Icon size={24} />
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="lifecycle-section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">How it works</p>
        <h2>The record grows with the relationship.</h2>
        <p>ScaleSafe is useful before a dispute because it helps you run a clearer client process while the program is active.</p>
      </div>
      <ol class="lifecycle-list">
        {lifecycle.map(([number, title, body]) => (
          <li><span>{number}</span><h3>{title}</h3><p>{body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="program-section">
    <div class="shell split-grid">
      <div>
        <p class="eyebrow">One client, many programs</p>
        <h2>Keep every purchase and promise in the right place.</h2>
        <p>Clients may buy several offers over time. ScaleSafe keeps each enrollment's price, payment status, delivery method, pulse schedule, and milestones together, so one program does not get confused with another.</p>
        <ul class="plain-list">
          <li><Check size={18} /> Payment progress and next billing date</li>
          <li><Check size={18} /> Program dates and delivery method</li>
          <li><Check size={18} /> Pulse cadence and client responses</li>
          <li><Check size={18} /> Milestones and sign-off</li>
        </ul>
        <a class="inline-link" href="/product">Follow the full client journey <ArrowRight size={17} /></a>
      </div>
      <figure>
        <div class="product-frame program-image"><img src="/images/product/client-programs-high-ticket.png" alt="ScaleSafe client record showing high-ticket program payments, pulse cadence, delivery, and milestones" width="1908" height="1008" loading="lazy" /></div>
        <figcaption class="image-caption">Program records preserve the payment, delivery window, pulse cadence, and milestone plan for each enrollment.</figcaption>
      </figure>
    </div>
  </section>

  <section class="attention-section">
    <div class="shell split-grid split-grid--reverse">
      <figure>
        <div class="product-frame pulse-image"><img src="/images/product/evidence-pulse-linked.png" alt="A client pulse check-in linked to the correct ScaleSafe program" width="1908" height="1008" loading="lazy" /></div>
        <figcaption class="image-caption">A client pulse response becomes timestamped, program-linked evidence and can alert the merchant when follow-up is requested.</figcaption>
      </figure>
      <div>
        <p class="eyebrow">Earlier attention</p>
        <h2>Give the client a simple way to speak up.</h2>
        <p>Pulse check-ins ask how the client is doing, what is going well, whether they have concerns, and whether they want someone to follow up. The answer helps the merchant respond earlier and becomes part of the program record.</p>
        <ul class="plain-list">
          <li><BellRing size={18} /> Surface responses that need attention</li>
          <li><MessageSquareText size={18} /> Preserve the client's own words</li>
          <li><CalendarCheck size={18} /> Keep the response with the active program</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="defense-section">
    <div class="shell split-grid">
      <div>
        <p class="eyebrow">If a dispute happens</p>
        <h2>Start with the transaction, then tell the story.</h2>
        <p>ScaleSafe brings the disputed payment, signed enrollment, client engagement, delivery records, and communications into a focused response. The dispute reason determines what evidence should lead.</p>
        <ul class="plain-list plain-list--dark">
          <li><ShieldCheck size={18} /> Keeps unrelated programs out of the packet</li>
          <li><FileText size={18} /> Builds a letter and organized exhibit list</li>
          <li><ClipboardCheck size={18} /> Holds uncertain packets for merchant review</li>
        </ul>
        <a class="inline-link" href="/evidence-defense">See evidence and defense <ArrowRight size={17} /></a>
      </div>
      <figure>
        <div class="product-frame letter-image"><img src="/images/product/defense-letter-active.png" alt="ScaleSafe chargeback defense letter for a high-ticket transaction" width="933" height="883" loading="lazy" /></div>
        <figcaption class="image-caption">A real test packet compiled around a selected $2,065 transaction and card-brand reason code.</figcaption>
      </figure>
    </div>
  </section>

  <section class="payments-section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Payments</p>
        <h2>Use the payment structure that fits the offer.</h2>
        <p>Sell paid in full, by installment, or by subscription. Offer card and bank payment where supported, keep refunds and lifecycle changes with the program, and let funds settle through your connected provider.</p>
      </div>
      <div class="payment-grid">
        {paymentChannels.map(([name, body]) => (
          <article><WalletCards size={23} /><h3>{name}</h3><p>{body}</p></article>
        ))}
      </div>
      <a class="inline-link inline-link--dark" href="/payments">Explore payments <ArrowRight size={17} /></a>
    </div>
  </section>

  <section class="connections-section">
    <div class="shell split-grid split-grid--reverse">
      <figure>
        <div class="product-frame connection-image"><img src="/images/product/evidence-connections-live.png" alt="ScaleSafe evidence connections showing native GoHighLevel fulfillment and Zoom" width="1908" height="1008" loading="lazy" /></div>
        <figcaption class="image-caption">GoHighLevel fulfillment and Zoom are connected in this active PMG test account.</figcaption>
      </figure>
      <div>
        <p class="eyebrow">Evidence connections</p>
        <h2>Bring delivery records in automatically.</h2>
        <p>ScaleSafe already uses GoHighLevel activity and can connect Zoom attendance. The integration catalog is expanding across course delivery, agency work, client portals, support, and other systems your business uses to fulfill.</p>
        <ul class="plain-list plain-list--dark">
          <li><Plug size={18} /> Merchant-owned connections</li>
          <li><Check size={18} /> Evidence linked to the correct client program</li>
          <li><Check size={18} /> Unclear activity stays out until it can be matched safely</li>
        </ul>
        <a class="inline-link" href="/integrations">See integrations <ArrowRight size={17} /></a>
      </div>
    </div>
  </section>

  <section class="pricing-section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Private beta pricing</p>
        <h2>One product. Two ways to qualify.</h2>
        <p>Both plans include the ScaleSafe client record, payment tracking, operational alerts, and defense workflow. WholePay Approved pricing is available only after WholePay verifies the merchant's NMI processing relationship.</p>
      </div>
      <div class="pricing-grid">
        <article class="price-card price-card--featured">
          <p class="plan-name">Standard</p><p class="price"><strong>$99</strong><span>/month</span></p>
          <p>For approved merchants using Stripe and/or Whop.</p>
          <ul><li><Check size={18} /> Stripe and Whop support</li><li><Check size={18} /> ScaleSafe evidence and defense workflow</li><li><Check size={18} /> Marketplace subscription</li></ul>
        </article>
        <article class="price-card">
          <p class="plan-name">WholePay Approved</p><p class="price"><strong>$59</strong><span>/month</span></p>
          <p>For merchants whose NMI processing account is approved and verified through WholePay.</p>
          <ul><li><Check size={18} /> Stripe, Whop, and NMI support</li><li><Check size={18} /> The same ScaleSafe product</li><li><Check size={18} /> Eligibility confirmed by WholePay</li></ul>
        </article>
      </div>
      <p class="pricing-note">Custom setup may be quoted when your business needs hands-on processor, workflow, fulfillment, or integration work.</p>
      <div class="pricing-actions"><a class="button" href="/beta">Request private beta access <ArrowRight size={18} /></a><a class="text-action" href="/pricing">View pricing details</a></div>
    </div>
  </section>

  <section class="final-cta">
    <div class="shell final-cta__grid">
      <div><p class="eyebrow">ScaleSafe private beta</p><h2>Stop rebuilding the client story after the dispute arrives.</h2></div>
      <div><p>Start with a clearer agreement, a better client record, and evidence that stays with the program it belongs to.</p><a class="button" href="/beta">Request beta access <ArrowRight size={18} /></a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { padding: 100px 0 0; background: linear-gradient(180deg,#f4fbf9 0%,#fff 68%); border-bottom:1px solid var(--line); }
  .home-hero__copy { padding-bottom: 58px; }
  .home-hero h1 { margin: 0 0 8px; font-size: clamp(4.3rem,8vw,7.4rem); }
  .hero-promise { margin-bottom:22px; color:var(--teal); font-family:var(--font-display); font-size:clamp(2rem,3.5vw,3.3rem); font-weight:700; line-height:1.1; }
  .hero-lead { max-width:780px; color:var(--slate); font-size:1.24rem; }
  .hero-actions { display:flex; align-items:center; gap:24px; margin-top:32px; }
  .text-action { color:var(--teal); font-weight:700; }
  .hero-facts { display:flex; flex-wrap:wrap; gap:12px 26px; margin:30px 0 0; padding:0; list-style:none; color:var(--slate); font-size:.9rem; }
  .hero-facts li { display:flex; align-items:center; gap:8px; }.hero-facts svg{color:var(--mint-dark)}
  .hero-product { margin-bottom:-84px; }.hero-product .product-frame{aspect-ratio:1.9}.home-hero:has(.hero-product){margin-bottom:84px}
  .record-section,.lifecycle-section,.program-section,.attention-section,.defense-section,.payments-section,.connections-section,.pricing-section{padding:110px 0}
  .record-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}
  .record-grid article{min-height:290px;padding:30px 24px;border-right:1px solid var(--line)}.record-grid article:last-child{border-right:0}.record-grid svg{margin-bottom:46px;color:var(--teal)}.record-grid p{color:var(--slate)}
  .lifecycle-section{background:var(--mist)}.lifecycle-list{display:grid;grid-template-columns:repeat(4,1fr);margin:0;padding:0;list-style:none}.lifecycle-list li{padding:28px 28px 10px 0;border-top:1px solid var(--line)}.lifecycle-list li+li{padding-left:28px;border-left:1px solid var(--line)}.lifecycle-list span{color:var(--mint-dark);font-family:var(--font-display);font-size:2rem;font-weight:800}.lifecycle-list h3{margin-top:28px}.lifecycle-list p{color:var(--slate)}
  .split-grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:72px;align-items:center}.split-grid--reverse{grid-template-columns:1.14fr .86fr}.split-grid>figure{margin:0}.split-grid h2{margin-bottom:24px}.split-grid>div>p:not(.eyebrow){color:var(--slate);font-size:1.08rem}.split-grid .inline-link{display:inline-flex;align-items:center;gap:8px;margin-top:28px;color:var(--teal);font-weight:700}
  .program-section{background:var(--white)}.program-image{aspect-ratio:1.65}.pulse-image{aspect-ratio:1.7}
  .attention-section{background:#fff8ef}.attention-section .product-frame{box-shadow:0 22px 60px rgba(102,69,24,.12)}
  .defense-section,.connections-section{color:var(--white);background:var(--ink)}.defense-section .split-grid>div>p:not(.eyebrow),.connections-section .split-grid>div>p:not(.eyebrow),.defense-section .image-caption,.connections-section .image-caption{color:var(--slate-light)}.plain-list--dark li{border-color:rgba(255,255,255,.15)}.plain-list--dark svg{color:var(--mint)}.defense-section .inline-link,.connections-section .inline-link{color:var(--mint)}.letter-image{aspect-ratio:1.06}.connection-image{aspect-ratio:1.7}
  .payments-section{background:var(--mist)}.payment-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);margin-bottom:28px}.payment-grid article{min-height:250px;padding:30px 30px 20px 0;border-right:1px solid var(--line)}.payment-grid article+article{padding-left:30px}.payment-grid article:last-child{border-right:0}.payment-grid svg{margin-bottom:36px;color:var(--teal)}.payment-grid p{color:var(--slate)}.inline-link--dark{display:inline-flex;align-items:center;gap:8px;color:var(--teal);font-weight:700}
  .connections-section{background:var(--ink-2)}
  .pricing-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.price-card{padding:38px;border:1px solid var(--line);border-radius:var(--radius);background:var(--mist)}.price-card--featured{color:var(--white);background:var(--blue);border-color:var(--blue)}.plan-name{font-weight:700}.price{display:flex;align-items:baseline;gap:7px}.price strong{font-family:var(--font-display);font-size:3.8rem;line-height:1}.price span,.price-card>p:nth-child(3){color:var(--slate)}.price-card--featured .price span,.price-card--featured>p:nth-child(3){color:#c7d4dc}.price-card ul{margin:28px 0 0;padding:0;list-style:none}.price-card li{display:flex;gap:9px;padding:10px 0;border-top:1px solid var(--line)}.price-card--featured li{border-color:rgba(255,255,255,.15)}.price-card li svg{flex:0 0 auto;color:var(--mint-dark)}.price-card--featured li svg{color:var(--mint)}.pricing-note{color:var(--slate);font-size:.9rem}.pricing-actions{display:flex;align-items:center;justify-content:center;gap:24px;margin-top:34px}
  .final-cta{padding:92px 0;color:var(--white);background:var(--blue)}.final-cta__grid{display:grid;grid-template-columns:1.2fr .8fr;gap:80px;align-items:end}.final-cta h2{margin:0}.final-cta__grid>div:last-child>p{color:#d6e1e8;font-size:1.08rem}
  @media(max-width:960px){.record-grid,.lifecycle-list{grid-template-columns:1fr 1fr}.record-grid article:nth-child(2),.lifecycle-list li:nth-child(2){border-right:0}.record-grid article{border-bottom:1px solid var(--line)}.split-grid,.split-grid--reverse{grid-template-columns:1fr;gap:46px}.payment-grid{grid-template-columns:1fr}.payment-grid article,.payment-grid article+article{min-height:0;padding:26px 0;border-right:0;border-bottom:1px solid var(--line)}.final-cta__grid{gap:44px}}
  @media(max-width:680px){.home-hero{padding-top:68px}.home-hero h1{font-size:4.2rem}.hero-promise{font-size:2rem}.hero-lead{font-size:1.06rem}.hero-actions{align-items:stretch;flex-direction:column}.hero-actions .text-action{text-align:center}.hero-facts{display:none}.hero-product{width:calc(100% - 14px);margin-bottom:-34px}.hero-product .product-frame{aspect-ratio:1.25}.home-hero:has(.hero-product){margin-bottom:34px}.record-section,.lifecycle-section,.program-section,.attention-section,.defense-section,.payments-section,.connections-section,.pricing-section{padding:82px 0}.record-grid,.lifecycle-list,.pricing-grid,.final-cta__grid{grid-template-columns:1fr}.record-grid article,.record-grid article:nth-child(2){min-height:0;border-right:0}.record-grid svg{margin-bottom:25px}.lifecycle-list li,.lifecycle-list li+li{padding:26px 0;border-left:0}.pricing-actions{align-items:stretch;flex-direction:column}.pricing-actions .text-action{text-align:center}}
</style>
