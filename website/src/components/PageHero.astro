---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image: string;
  alt: string;
  compact?: boolean;
}

const { eyebrow, title, lead, image, alt, compact = false } = Astro.props;
---

<section class:list={["page-hero", compact && "page-hero--compact"]}>
  <img src={image} alt={alt} width="1920" height="968" />
  <div class="page-hero__veil"></div>
  <div class="shell page-hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: 590px;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--white);
    background: var(--ink);
  }

  .page-hero--compact {
    min-height: 470px;
  }

  .page-hero > img,
  .page-hero__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero > img {
    object-fit: cover;
    object-position: center top;
    opacity: 0.5;
  }

  .page-hero__veil {
    background: rgba(4, 18, 34, 0.78);
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
    padding: 100px 0 82px;
  }

  .page-hero h1 {
    max-width: 980px;
    margin-bottom: 24px;
  }

  .page-hero__content > p:last-child {
    max-width: 760px;
    margin-bottom: 0;
    color: #d6e1e8;
    font-size: 1.22rem;
  }

  @media (max-width: 720px) {
    .page-hero,
    .page-hero--compact {
      min-height: 520px;
    }

    .page-hero__content {
      padding: 88px 0 66px;
    }

    .page-hero h1 {
      font-size: 3.2rem;
    }
  }
</style>
