---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image?: string;
  alt?: string;
  caption?: string;
  compact?: boolean;
}

const { eyebrow, title, lead, image, alt = "", caption, compact = false } = Astro.props;
---

<section class:list={["page-hero", compact && "page-hero--compact"]}>
  <div class="shell page-hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
  {image && (
    <figure class="shell page-hero__product">
      <div class="product-frame">
        <img src={image} alt={alt} width="1920" height="968" />
      </div>
      {caption && <figcaption class="image-caption">{caption}</figcaption>}
    </figure>
  )}
</section>

<style>
  .page-hero {
    padding: 96px 0 0;
    overflow: hidden;
    background: linear-gradient(180deg, #f7fbfb 0%, #ffffff 72%);
    border-bottom: 1px solid var(--line);
  }

  .page-hero--compact {
    padding-bottom: 86px;
  }

  .page-hero__content {
    padding-bottom: 58px;
  }

  .page-hero h1 {
    max-width: 1040px;
    margin-bottom: 36px;
    font-size: clamp(3.1rem, 5vw, 4.65rem);
  }

  .page-hero__content > p:last-child {
    max-width: 790px;
    margin-bottom: 0;
    color: var(--slate);
    font-size: 1.22rem;
  }

  .page-hero__product {
    margin-bottom: -72px;
  }

  .page-hero__product .product-frame {
    aspect-ratio: 1.9;
    background: var(--mist);
  }

  .page-hero__product img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .page-hero:has(.page-hero__product) {
    margin-bottom: 72px;
  }

  @media (max-width: 720px) {
    .page-hero {
      padding-top: 68px;
    }

    .page-hero__content {
      padding-bottom: 42px;
    }

    .page-hero h1 {
      margin-bottom: 24px;
      font-size: 2.55rem;
    }

    .page-hero__content > p:last-child {
      font-size: 1.06rem;
    }

    .page-hero__product {
      width: calc(100% - 14px);
      margin-bottom: -34px;
    }

    .page-hero__product .product-frame {
      aspect-ratio: 1.25;
    }

    .page-hero:has(.page-hero__product) {
      margin-bottom: 34px;
    }
  }
</style>
