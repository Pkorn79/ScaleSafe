---
import { ArrowRight } from "@lucide/astro";

interface Props {
  title?: string;
  body?: string;
}

const {
  title = "Build the record before you need the defense.",
  body = "Request private beta access and we will follow up about your payment channel, offers, and fulfillment systems.",
} = Astro.props;
---

<section class="cta-band">
  <div class="shell">
    <div>
      <p class="eyebrow">ScaleSafe private beta</p>
      <h2>{title}</h2>
    </div>
    <div>
      <p>{body}</p>
      <a class="button" href="/beta">Request beta access <ArrowRight size={18} /></a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding: 86px 0;
    color: var(--white);
    background: var(--blue);
  }

  .cta-band > div {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: end;
  }

  .cta-band h2 {
    margin-bottom: 0;
  }

  .cta-band > div > div:last-child > p {
    color: #d6e1e8;
    font-size: 1.08rem;
  }

  @media (max-width: 760px) {
    .cta-band > div {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
</style>

