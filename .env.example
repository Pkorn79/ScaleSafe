# ============================================
# ScaleSafe Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to the repo
# ============================================

# GHL Marketplace App (from GHL Developer Portal)
GHL_APP_CLIENT_ID=
GHL_APP_CLIENT_SECRET=
GHL_APP_SSO_KEY=
GHL_API_DOMAIN=https://services.leadconnectorhq.com

# Supabase (from Supabase project settings)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Claude API (for AI Defense Compiler)
ANTHROPIC_API_KEY=

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Optional: enables /api/debug/* routes when supplied by trusted admin callers
DEBUG_ADMIN_TOKEN=

# Local-only shortcut for tests/dev tools that send x-location-id without GHL SSO
ALLOW_DEV_LOCATION_AUTH=false

# Optional: separate HMAC secret for signed client action links.
# Falls back to GHL_APP_SSO_KEY when unset.
PUBLIC_ACTION_TOKEN_SECRET=

# Emergency compatibility only: allow old public links with raw contactId/locationId in production.
ALLOW_LEGACY_PUBLIC_ACTION_LINKS=false

# Emergency compatibility only: allow official GHL marketplace webhooks without signature in production.
ALLOW_UNSIGNED_GHL_WEBHOOKS=false

# Rollout flag for GHL workflow Custom Webhook shared secrets.
# false = observe/log only, true = reject missing/invalid x-scalesafe-webhook-secret headers.
REQUIRE_WEBHOOK_SECRET=false

# UI-only testing flag: shows Daily (Testing) as an offer billing frequency.
# Use only in sandbox/test builds for recurring billing verification.
VITE_ENABLE_DAILY_TEST_BILLING=false
