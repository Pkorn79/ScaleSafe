# Copy to /etc/scalesafe-recovery/backup.env on the dedicated backup host.
# Set file permissions to 0600. Never commit the populated file.

SUPABASE_PROJECT_REF=replace-with-production-project-ref
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# Generate server-side S3 credentials under Supabase Storage > Configuration > S3.
SUPABASE_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=replace-with-project-region
SUPABASE_STORAGE_ACCESS_KEY_ID=replace-with-access-key
SUPABASE_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-key

# Configure this rclone remote separately. The destination bucket must have
# versioning and provider-side immutability/Object Lock enabled.
BACKUP_DEST_REMOTE=offsite:scalesafe-production
BACKUP_DESTINATION_CONFIRMED_IMMUTABLE=false

# This is the public recipient only. Keep the matching private identity offline.
BACKUP_AGE_RECIPIENT=age1replace-with-public-recipient

BACKUP_WORK_DIR=/var/lib/scalesafe-recovery
BACKUP_LOCK_FILE=/var/lock/scalesafe-backup.lock
BACKUP_MAX_LOCAL_GB=25
VERIFY_OFFSITE_DOWNLOAD=true
MAX_BACKUP_AGE_HOURS=30

# Optional deployment reference recorded in the encrypted metadata.
APP_GIT_SHA=
