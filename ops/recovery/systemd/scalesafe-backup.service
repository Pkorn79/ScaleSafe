[Unit]
Description=ScaleSafe encrypted off-platform backup
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=scalesafe-backup
Group=scalesafe-backup
SupplementaryGroups=docker
WorkingDirectory=/opt/scalesafe-recovery
ExecStart=/opt/scalesafe-recovery/backup.sh /etc/scalesafe-recovery/backup.env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/scalesafe-recovery /var/lock
