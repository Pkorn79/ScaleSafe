# Copy to a temporary file on the restore workstation only.
# Set file permissions to 0600 and delete it after the drill.

BACKUP_DEST_REMOTE=offsite:scalesafe-production
AGE_IDENTITY_FILE=/secure/offline-media/scalesafe-age-identity.txt
RESTORE_WORK_DIR=/var/lib/scalesafe-restore

PRODUCTION_PROJECT_REF=replace-with-production-project-ref
RESTORE_TARGET_PROJECT_REF=replace-with-new-scratch-project-ref
RESTORE_TARGET_DB_URL=postgresql://postgres.SCRATCH_REF:PASSWORD@POOLER_HOST:5432/postgres

# Generate temporary S3 credentials in the scratch project.
RESTORE_TARGET_STORAGE_ENDPOINT=https://SCRATCH_REF.storage.supabase.co/storage/v1/s3
RESTORE_TARGET_STORAGE_REGION=replace-with-scratch-region
RESTORE_TARGET_STORAGE_ACCESS_KEY_ID=replace-with-scratch-access-key
RESTORE_TARGET_STORAGE_SECRET_ACCESS_KEY=replace-with-scratch-secret-key

# The script will not run without this exact acknowledgement.
RESTORE_CONFIRMATION=
